<Window x:Class="FACTOVA_MessageLogViewer.ColumnSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Preset Settings" 
        Height="700" Width="950"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Preset Settings" FontSize="18" FontWeight="Bold"/>
            <TextBlock Text="Column and Tab settings are saved together as a preset."
                       Foreground="#666" FontSize="12" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Preset Management -->
        <GroupBox Grid.Row="1" Header="Preset" Margin="0,0,0,10" Padding="10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Preset:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                <ComboBox x:Name="cboPresets" Width="180" Height="28" FontSize="12"
                          SelectionChanged="CboPresets_SelectionChanged"/>
                <Button Content="Save" Width="60" Height="28" Margin="15,0,0,0" Click="BtnSavePreset_Click"
                        ToolTip="Save to current preset"/>
                <Border Width="1" Background="#CCC" Margin="15,2"/>
                <TextBlock Text="New:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="txtPresetName" Width="130" Height="28" 
                         VerticalContentAlignment="Center" FontSize="12"
                         ToolTip="Enter new preset name"/>
                <Button Content="Save As" Width="80" Height="28" Margin="10,0,0,0" Click="BtnSaveAsPreset_Click"/>
            </StackPanel>
        </GroupBox>

        <!-- TabControl (Column Settings / Tab Settings) -->
        <TabControl Grid.Row="2">
            <!-- Column Settings Tab -->
            <TabItem Header="Column Settings">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Column: Show as column | Summary: Show in summary | Hidden: Hide"
                                   Foreground="#666" FontSize="11" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="All Summary" Width="100" Height="26" Click="BtnAllSummary_Click" FontSize="11"/>
                            <Button Content="All Hidden" Width="90" Height="26" Margin="10,0,0,0" Click="BtnAllHidden_Click" FontSize="11"/>
                            <TextBlock Text="  |  " VerticalAlignment="Center" Foreground="#999"/>
                            <Button Content="Up" Width="30" Height="26" Margin="10,0,0,0" Click="BtnMoveUp_Click" FontSize="11"/>
                            <Button Content="Down" Width="30" Height="26" Margin="5,0,0,0" Click="BtnMoveDown_Click" FontSize="11"/>
                            <TextBlock Text="  |  " VerticalAlignment="Center" Foreground="#999"/>
                            <Button Content="Reanalyze" Width="80" Height="26" Margin="10,0,0,0" Click="BtnReanalyze_Click" FontSize="11"
                                    ToolTip="Scan log file for new fields"/>
                        </StackPanel>
                        <Border Background="#E3F2FD" BorderBrush="#2196F3" BorderThickness="1" CornerRadius="3" Padding="8" Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="체크한 항목 일괄 변경:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
                                <ComboBox x:Name="cboBulkChange" Width="100" Height="26" FontSize="11">
                                    <ComboBoxItem Content="Column"/>
                                    <ComboBoxItem Content="Summary"/>
                                    <ComboBoxItem Content="Hidden"/>
                                </ComboBox>
                                <Button Content="적용" Width="60" Height="26" Margin="10,0,0,0" Click="BtnBulkChange_Click" FontSize="11"
                                        Background="#2196F3" Foreground="White" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <DataGrid Grid.Row="1" 
                              x:Name="dgFields"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Extended"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              Background="White"
                              RowHeight="32"
                              FontSize="12">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="선택" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="50"/>
                            <DataGridTextColumn Header="#" Binding="{Binding Order}" Width="40" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Field Name" Binding="{Binding FieldName, UpdateSourceTrigger=PropertyChanged}" Width="150"/>
                            <DataGridTextColumn Header="Display Name" Binding="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                            <DataGridComboBoxColumn Header="Display Type" 
                                                     SelectedItemBinding="{Binding DisplayTypeString, UpdateSourceTrigger=PropertyChanged}" 
                                                     Width="100">
                                <DataGridComboBoxColumn.ItemsSource>
                                    <x:Array Type="{x:Type sys:String}" xmlns:sys="clr-namespace:System;assembly=mscorlib">
                                        <sys:String>Column</sys:String>
                                        <sys:String>Summary</sys:String>
                                        <sys:String>Hidden</sys:String>
                                    </x:Array>
                                </DataGridComboBoxColumn.ItemsSource>
                            </DataGridComboBoxColumn>
                            <DataGridTextColumn Header="Width" Binding="{Binding ColumnWidth, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                            <DataGridTextColumn Header="Value Mapping" Binding="{Binding ValueMapping, UpdateSourceTrigger=PropertyChanged}" Width="150">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="ToolTip" Value="예: 1:장입,2:미장입"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Sample Values" Binding="{Binding SamplePreview}" Width="*" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#666"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Tab Settings Tab -->
            <TabItem Header="Tab Settings">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Tab List -->
                    <Border Grid.Column="0" Background="White" BorderBrush="#DDD" BorderThickness="1" CornerRadius="5" Margin="0,0,10,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Tab List" FontWeight="Bold" Margin="10" Foreground="#555"/>

                            <ListBox Grid.Row="1" 
                                     x:Name="listBoxTabs"
                                     Margin="5"
                                     SelectionChanged="ListBoxTabs_SelectionChanged"
                                     HorizontalContentAlignment="Stretch">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" 
                                                      IsChecked="{Binding IsEnabled}" 
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,8,0"
                                                      Checked="TabEnabled_Changed"
                                                      Unchecked="TabEnabled_Changed"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding ConditionSummary}" 
                                                           FontSize="10" Foreground="#888"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="10">
                                <Button Content="+ Add" Width="60" Height="28" Click="BtnAddTab_Click" Margin="0,0,5,0"/>
                                <Button Content="Remove" Width="60" Height="28" Click="BtnRemoveTab_Click" Margin="0,0,5,0"/>
                                <Button Content="Up" Width="30" Height="28" Click="BtnTabMoveUp_Click"/>
                                <Button Content="Dn" Width="30" Height="28" Click="BtnTabMoveDown_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Tab Details -->
                    <Border Grid.Column="1" Background="White" BorderBrush="#DDD" BorderThickness="1" CornerRadius="5">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="panelTabDetails" Margin="15">
                                <TextBlock Text="Tab Details" FontWeight="Bold" FontSize="14" Margin="0,0,0,15"/>

                                <TextBlock Text="Tab Name:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <TextBox x:Name="txtTabName" 
                                         Height="30" 
                                         Padding="8,5"
                                         TextChanged="TxtTabName_TextChanged"/>

                                <CheckBox x:Name="chkIsIntegrated" 
                                          Content="Integrated Log Tab (Show All Logs)"
                                          Margin="0,15,0,0"
                                          Checked="ChkIsIntegrated_Changed"
                                          Unchecked="ChkIsIntegrated_Changed"/>

                                <TextBlock Text="Condition Groups (OR between groups):" FontWeight="SemiBold" Margin="0,20,0,5"/>
                                <TextBlock Text="Groups are OR. Conditions in a group are AND." 
                                           FontSize="11" Foreground="#888" Margin="0,0,0,10"/>

                                <ItemsControl x:Name="itemsConditionGroups">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#F0F7FF" BorderBrush="#90CAF9" BorderThickness="1" 
                                                    CornerRadius="5" Padding="10" Margin="0,0,0,10">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,8">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Group:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" 
                                                                     Width="150" Height="26" Padding="5,3"/>
                                                        </StackPanel>
                                                        <Button Content="Delete" 
                                                                HorizontalAlignment="Right"
                                                                Width="60" Height="26"
                                                                Background="#FFCDD2"
                                                                Click="BtnRemoveGroup_Click"
                                                                Tag="{Binding}"/>
                                                    </Grid>

                                                    <ItemsControl ItemsSource="{Binding Conditions}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                 <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" 
                                                                        CornerRadius="3" Padding="8" Margin="0,0,0,8">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>

                                                                        <!-- Field, Value, Exact -->
                                                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                                            <TextBlock Text="Field:" Width="50" VerticalAlignment="Center"/>
                                                                            <ComboBox Width="120" 
                                                                                      Text="{Binding FieldName, UpdateSourceTrigger=PropertyChanged}"
                                                                                      IsEditable="True"
                                                                                      ItemsSource="{Binding FieldList, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                            <TextBlock Text="Value:" Width="45" VerticalAlignment="Center" Margin="15,0,0,0"/>
                                                                            <TextBox Width="100" 
                                                                                     Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                                                     ToolTip="여러 값은 쉼표로 구분 (예: 2,3)"/>
                                                                            <CheckBox Content="Exact" 
                                                                                      IsChecked="{Binding ExactMatch}"
                                                                                      VerticalAlignment="Center" Margin="10,0,0,0"/>
                                                                        </StackPanel>

                                                                        <!-- X Button -->
                                                                        <Button Grid.Column="1" Content="X" 
                                                                                Width="22" Height="22"
                                                                                VerticalAlignment="Center"
                                                                                Click="BtnRemoveConditionInGroup_Click"
                                                                                Tag="{Binding}"/>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <Button Content="+ Add Condition (AND)" 
                                                            Width="140" Height="26" 
                                                            HorizontalAlignment="Left"
                                                            Margin="0,5,0,0"
                                                            Click="BtnAddConditionToGroup_Click"
                                                            Tag="{Binding}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Button Content="+ Add Group (OR)" 
                                        Width="120" 
                                        Height="28" 
                                        HorizontalAlignment="Left"
                                        Margin="0,5,0,0"
                                        Background="#E3F2FD"
                                        Click="BtnAddGroup_Click"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Bottom Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Reset" Width="80" Height="32" Click="BtnReset_Click" FontSize="12"/>
            <Button Content="Cancel" Width="80" Height="32" Margin="10,0,0,0" Click="BtnCancel_Click" FontSize="12"/>
            <Button Content="Apply" Width="100" Height="32" Margin="10,0,0,0" 
                    Background="#4CAF50" Foreground="White" FontWeight="Bold"
                    Click="BtnApply_Click" FontSize="12"/>
        </StackPanel>
    </Grid>
</Window>
