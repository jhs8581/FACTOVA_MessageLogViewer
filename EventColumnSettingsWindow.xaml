<Window x:Class="FACTOVA_MessageLogViewer.EventColumnSettingsWindow"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
Title="EVENT 로그 프리셋 설정" 
Height="700" Width="950"
WindowStartupLocation="CenterOwner"
Background="#F5F5F5"
Icon="pack://application:,,,/Icons/free-icon-search-10725247.ico">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="EVENT 로그 프리셋 설정" FontSize="18" FontWeight="Bold"/>
            <TextBlock Text="컬럼과 탭 설정이 프리셋으로 함께 저장됩니다."
                       Foreground="#666" FontSize="12" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Preset Management -->
        <GroupBox Grid.Row="1" Header="프리셋" Margin="0,0,0,10" Padding="10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="프리셋:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                <ComboBox x:Name="cboPresets" Width="180" Height="28" FontSize="12"
                          SelectionChanged="CboPresets_SelectionChanged"/>
                <Button Content="저장" Width="60" Height="28" Margin="15,0,0,0" Click="BtnSavePreset_Click"
                        ToolTip="현재 프리셋에 저장"/>
                <Border Width="1" Background="#CCC" Margin="15,2"/>
                <TextBlock Text="새 이름:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="txtPresetName" Width="130" Height="28" 
                         VerticalContentAlignment="Center" FontSize="12"
                         ToolTip="새 프리셋 이름 입력"/>
                <Button Content="다른이름저장" Width="80" Height="28" Margin="10,0,0,0" Click="BtnSaveAsPreset_Click"/>
                <Border Width="1" Background="#CCC" Margin="15,2"/>
                <Button Content="🗑 삭제" Width="60" Height="28" Click="BtnDeletePreset_Click"
                        Background="#FFEBEE" Foreground="#C62828" BorderBrush="#EF9A9A"
                        ToolTip="현재 선택된 프리셋 삭제 (Default는 삭제 불가)"/>
                <Button Content="📂 폴더" Width="60" Height="28" Margin="5,0,0,0" Click="BtnOpenPresetFolder_Click"
                        ToolTip="프리셋 저장 폴더를 파일 탐색기로 열기"/>
            </StackPanel>
        </GroupBox>

        <!-- TabControl (Column Settings / Tab Settings) -->
        <TabControl Grid.Row="2">
            <!-- Column Settings Tab -->
            <TabItem Header="컬럼 설정">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>


                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Column: 컬럼으로 표시 | Summary: 요약에 표시 | Hidden: 숨김"
                                   Foreground="#666" FontSize="11" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="전체 요약" Width="80" Height="26" Click="BtnAllSummary_Click" FontSize="11"/>
                            <Button Content="전체 숨김" Width="80" Height="26" Margin="5,0,0,0" Click="BtnAllHidden_Click" FontSize="11"/>
                            <TextBlock Text="  |  " VerticalAlignment="Center" Foreground="#999"/>
                            <Button Content="▲" Width="26" Height="26" Margin="5,0,0,0" Click="BtnMoveUp_Click" FontSize="11" ToolTip="위로 이동"/>
                            <Button Content="▼" Width="26" Height="26" Margin="3,0,0,0" Click="BtnMoveDown_Click" FontSize="11" ToolTip="아래로 이동"/>
                            <Button Content="순번 적용" Width="70" Height="26" Margin="5,0,0,0" Click="BtnApplyOrder_Click" FontSize="11" 
                                    ToolTip="입력한 순번대로 정렬" Background="#FF9800" Foreground="White" FontWeight="Bold"/>
                            <TextBlock Text="  |  " VerticalAlignment="Center" Foreground="#999"/>
                            <ComboBox x:Name="cboSortType" Width="80" Height="26" FontSize="11" SelectedIndex="0">
                                <ComboBoxItem Content="Column"/>
                                <ComboBoxItem Content="Summary"/>
                                <ComboBoxItem Content="Hidden"/>
                            </ComboBox>
                            <Button Content="정렬" Width="40" Height="26" Margin="3,0,0,0" Click="BtnSortByType_Click" FontSize="11" 
                                    ToolTip="선택한 타입을 맨 위로 정렬"/>
                            <TextBlock Text="  |  " VerticalAlignment="Center" Foreground="#999"/>
                            <Button Content="재분석" Width="60" Height="26" Margin="5,0,0,0" Click="BtnReanalyze_Click" FontSize="11"
                                    ToolTip="로그 파일에서 새 필드 검색"/>
                        </StackPanel>
                        <Border Background="#E3F2FD" BorderBrush="#2196F3" BorderThickness="1" CornerRadius="3" Padding="8" Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="체크한 항목 일괄 변경:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
                                <ComboBox x:Name="cboBulkChange" Width="100" Height="26" FontSize="11">
                                    <ComboBoxItem Content="Column"/>
                                    <ComboBoxItem Content="Summary"/>
                                    <ComboBoxItem Content="Hidden"/>
                                </ComboBox>
                                <Button Content="적용" Width="60" Height="26" Margin="10,0,0,0" Click="BtnBulkChange_Click" FontSize="11"
                                        Background="#2196F3" Foreground="White" FontWeight="Bold"/>
                                <Border Width="1" Background="#90CAF9" Margin="15,2"/>
                                <TextBlock Text="표시할 탭:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
                                <Button Content="일괄 설정" Width="80" Height="26" Click="BtnBulkSetTabs_Click" FontSize="11"
                                        Background="#4CAF50" Foreground="White" FontWeight="Bold"
                                        ToolTip="체크한 항목들의 표시할 탭을 일괄 설정"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <DataGrid Grid.Row="1" 
                              x:Name="dgFields"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Extended"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              Background="White"
                              RowHeight="32"
                              FontSize="12">
                        <DataGrid.Columns>
                            <!-- 체크박스: 싱글클릭 및 키보드 지원 -->
                            <DataGridCheckBoxColumn Header="선택" 
                                                     Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" 
                                                     Width="50">
                                <DataGridCheckBoxColumn.ElementStyle>
                                    <Style TargetType="CheckBox">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridCheckBoxColumn.ElementStyle>
                            </DataGridCheckBoxColumn>
                            <DataGridTextColumn Header="#" Binding="{Binding Order, UpdateSourceTrigger=PropertyChanged}" Width="50">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="TextBox">
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="필드명" Binding="{Binding FieldName, UpdateSourceTrigger=PropertyChanged}" Width="150"/>
                            <DataGridTextColumn Header="표시명" Binding="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                            <DataGridComboBoxColumn Header="표시타입" 
                                                     SelectedItemBinding="{Binding DisplayTypeString, UpdateSourceTrigger=PropertyChanged}" 
                                                     Width="100">
                                <DataGridComboBoxColumn.ItemsSource>
                                    <x:Array Type="{x:Type sys:String}" xmlns:sys="clr-namespace:System;assembly=mscorlib">
                                        <sys:String>Column</sys:String>
                                        <sys:String>Summary</sys:String>
                                        <sys:String>Hidden</sys:String>
                                    </x:Array>
                                </DataGridComboBoxColumn.ItemsSource>
                            </DataGridComboBoxColumn>
                            <!-- 너비 컬럼 제거: AutoFit이 자동 적용되므로 불필요 -->
                            <DataGridTemplateColumn Header="표시할 탭" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding VisibleTabsDisplayText}" 
                                                Click="BtnSelectTabs_Click"
                                                Tag="{Binding}"
                                                HorizontalAlignment="Stretch"
                                                Padding="4,2"
                                                ToolTip="클릭하여 탭 선택"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="값 매핑" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding ValueMappingDisplayText}" 
                                                Click="BtnEditValueMapping_Click"
                                                Tag="{Binding}"
                                                HorizontalAlignment="Stretch"
                                                Padding="4,2"
                                                ToolTip="클릭하여 값 매핑 편집&#x0a;예: 1→자동, 2→수동"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="샘플 값" Binding="{Binding SamplePreview}" Width="*" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#666"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Tab Settings Tab -->
            <TabItem Header="탭 설정">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Tab List -->
                    <Border Grid.Column="0" Background="White" BorderBrush="#DDD" BorderThickness="1" CornerRadius="5" Margin="0,0,10,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="탭 목록" FontWeight="Bold" Margin="10" Foreground="#555"/>

                            <ListBox Grid.Row="1" 
                                     x:Name="listBoxTabs"
                                     Margin="5"
                                     SelectionChanged="ListBoxTabs_SelectionChanged"
                                     HorizontalContentAlignment="Stretch">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" 
                                                      IsChecked="{Binding IsEnabled}" 
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,8,0"
                                                      Checked="TabEnabled_Changed"
                                                      Unchecked="TabEnabled_Changed"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding ConditionSummary}" 
                                                           FontSize="10" Foreground="#888"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="10">
                                <Button Content="+ 추가" Width="60" Height="28" Click="BtnAddTab_Click" Margin="0,0,5,0"/>
                                <Button Content="삭제" Width="60" Height="28" Click="BtnRemoveTab_Click" Margin="0,0,5,0"/>
                                <Button Content="▲" Width="30" Height="28" Click="BtnTabMoveUp_Click"/>
                                <Button Content="▼" Width="30" Height="28" Click="BtnTabMoveDown_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Tab Details -->
                    <Border Grid.Column="1" Background="White" BorderBrush="#DDD" BorderThickness="1" CornerRadius="5">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="panelTabDetails" Margin="15">
                                <TextBlock Text="탭 상세" FontWeight="Bold" FontSize="14" Margin="0,0,0,15"/>

                                <TextBlock Text="탭 이름:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <TextBox x:Name="txtTabName" 
                                         Height="30" 
                                         Padding="8,5"
                                         TextChanged="TxtTabName_TextChanged"/>

                                <CheckBox x:Name="chkIsIntegrated" 
                                          Content="통합 로그 탭 (모든 로그 표시)"
                                          Margin="0,15,0,0"
                                          Checked="ChkIsIntegrated_Changed"
                                          Unchecked="ChkIsIntegrated_Changed"/>

                                <TextBlock Text="조건 그룹 (그룹 간 OR):" FontWeight="SemiBold" Margin="0,20,0,5"/>
                                <TextBlock Text="그룹 간에는 OR, 그룹 내 조건은 AND로 적용됩니다." 
                                           FontSize="11" Foreground="#888" Margin="0,0,0,10"/>

                                <ItemsControl x:Name="itemsConditionGroups">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#F0F7FF" BorderBrush="#90CAF9" BorderThickness="1" 
                                                    CornerRadius="5" Padding="10" Margin="0,0,0,10">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,8">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="그룹:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" 
                                                                     Width="150" Height="26" Padding="5,3"/>
                                                        </StackPanel>
                                                        <Button Content="삭제" 
                                                                HorizontalAlignment="Right"
                                                                Width="60" Height="26"
                                                                Background="#FFCDD2"
                                                                Click="BtnRemoveGroup_Click"
                                                                Tag="{Binding}"/>
                                                    </Grid>

                                                    <ItemsControl ItemsSource="{Binding Conditions}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" 
                                                                        CornerRadius="3" Padding="8" Margin="0,0,0,8">
                                                                    <Grid>
                                                                        <Grid.RowDefinitions>
                                                                            <RowDefinition Height="Auto"/>
                                                                            <RowDefinition Height="Auto"/>
                                                                        </Grid.RowDefinitions>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>

                                                                        <!-- 키워드 검색 체크박스 -->
                                                                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,5">
                                                                            <CheckBox x:Name="chkKeywordSearch"
                                                                                      Content="🔍 키워드 검색" 
                                                                                      IsChecked="{Binding IsKeywordSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                      VerticalAlignment="Center"
                                                                                      FontWeight="SemiBold"
                                                                                      Foreground="#1976D2"
                                                                                      ToolTip="체크하면 필드 무시하고 전체 로그에서 키워드 포함 검색"/>
                                                                            <TextBlock Text="(로그에 키워드가 포함되면 매칭)" 
                                                                                       Foreground="#888" FontSize="10" 
                                                                                       VerticalAlignment="Center" Margin="10,0,0,0">
                                                                                <TextBlock.Style>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding IsKeywordSearch}" Value="True">
                                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </TextBlock.Style>
                                                                            </TextBlock>
                                                                        </StackPanel>

                                                                        <!-- Field, Value, Exact -->
                                                                        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal">
                                                                            <!-- 필드 라벨 (키워드 검색 시 숨김) -->
                                                                            <TextBlock Text="필드:" Width="50" VerticalAlignment="Center">
                                                                                <TextBlock.Style>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding IsKeywordSearch}" Value="True">
                                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </TextBlock.Style>
                                                                            </TextBlock>
                                                                            <!-- 필드 콤보박스 (키워드 검색 시 숨김) -->
                                                                            <ComboBox Width="120" 
                                                                                      Text="{Binding FieldName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                      IsEditable="True"
                                                                                      IsTextSearchEnabled="True"
                                                                                      StaysOpenOnEdit="True"
                                                                                      ItemsSource="{Binding FieldList, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                      SelectionChanged="ConditionFieldComboBox_SelectionChanged"
                                                                                      LostFocus="ConditionFieldComboBox_LostFocus">
                                                                                <ComboBox.Style>
                                                                                    <Style TargetType="ComboBox">
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding IsKeywordSearch}" Value="True">
                                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </ComboBox.Style>
                                                                            </ComboBox>
                                                                            <!-- 키워드 라벨 (키워드 검색 시 표시) -->
                                                                            <TextBlock Text="키워드:" Width="55" VerticalAlignment="Center">
                                                                                <TextBlock.Style>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding IsKeywordSearch}" Value="True">
                                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </TextBlock.Style>
                                                                            </TextBlock>
                                                                            <!-- 값 라벨 (키워드 검색 시 숨김) -->
                                                                            <TextBlock Text="값:" Width="45" VerticalAlignment="Center" Margin="15,0,0,0">
                                                                                <TextBlock.Style>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding IsKeywordSearch}" Value="True">
                                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </TextBlock.Style>
                                                                            </TextBlock>
                                                                            <TextBox Width="180" 
                                                                                     Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                                                     ToolTip="키워드 검색: 포함할 키워드&#x0a;필드 검색: 여러 값은 쉼표로 구분"/>
                                                                            <!-- 정확히 일치 (키워드 검색 시 숨김) -->
                                                                            <CheckBox Content="정확히 일치" 
                                                                                      IsChecked="{Binding ExactMatch}"
                                                                                      VerticalAlignment="Center" Margin="10,0,0,0">
                                                                                <CheckBox.Style>
                                                                                    <Style TargetType="CheckBox">
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding IsKeywordSearch}" Value="True">
                                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </CheckBox.Style>
                                                                            </CheckBox>
                                                                        </StackPanel>

                                                                        <!-- X Button -->
                                                                        <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Content="X" 
                                                                                Width="22" Height="22"
                                                                                VerticalAlignment="Center"
                                                                                Click="BtnRemoveConditionInGroup_Click"
                                                                                Tag="{Binding}"/>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <Button Content="+ 조건 추가 (AND)" 
                                                            Width="140" Height="26" 
                                                            HorizontalAlignment="Left"
                                                            Margin="0,5,0,0"
                                                            Click="BtnAddConditionToGroup_Click"
                                                            Tag="{Binding}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Button Content="+ 그룹 추가 (OR)" 
                                        Width="120" 
                                        Height="28" 
                                        HorizontalAlignment="Left"
                                        Margin="0,5,0,0"
                                        Background="#E3F2FD"
                                        Click="BtnAddGroup_Click"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Filter Settings Tab -->
            <TabItem Header="필터 설정">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <!-- Excluded MSGID Section -->
                        <GroupBox Header="🚫 제외할 MSGID" Padding="15" Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="파싱에서 제외할 MSGID를 쉼표로 구분하여 입력하세요." 
                                           Foreground="#666" FontSize="12" Margin="0,0,0,5"/>
                                <TextBlock Text="예: S6F1,S6F11,S1F3" 
                                           Foreground="#999" FontSize="11" Margin="0,0,0,10"/>
                                <TextBox x:Name="txtExcludedMsgIds" 
                                         Height="60" 
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"
                                         FontSize="12"
                                         FontFamily="Consolas"
                                         Padding="8"
                                         ToolTip="제외할 MSGID를 쉼표로 구분하여 입력"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- Include Keywords Section -->
                        <GroupBox Header="✅ 포함할 키워드 (MSGID 없는 로그 수집)" Padding="15" Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap" Foreground="#666" FontSize="12" Margin="0,0,0,5">
                                    <Run Text="MSGID가 없는 로그 중 수집할 키워드를 "/>
                                    <Run Text="한 줄에 하나씩" FontWeight="Bold" Foreground="#1976D2"/>
                                    <Run Text=" 입력하세요."/>
                                </TextBlock>
                                <TextBlock Text="해당 키워드가 포함된 로그는 MSGID가 없어도 수집됩니다." 
                                           Foreground="#666" FontSize="12" Margin="0,0,0,5"/>
                                <Border Background="#FFF3E0" BorderBrush="#FFB74D" BorderThickness="1" 
                                        CornerRadius="3" Padding="8" Margin="0,0,0,10">
                                    <TextBlock FontSize="11" Foreground="#E65100" TextWrapping="Wrap">
                                        <Run Text="예시:"/>
                                        <LineBreak/>
                                        <Run Text="SFC2_PalletDoor_Auto_Buffer" FontFamily="Consolas"/>
                                        <LineBreak/>
                                        <Run Text="GetDoorLoading" FontFamily="Consolas"/>
                                        <LineBreak/>
                                        <Run Text="PALLET_ID" FontFamily="Consolas"/>
                                    </TextBlock>
                                </Border>
                                <TextBox x:Name="txtIncludeKeywords" 
                                         Height="120" 
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"
                                         FontSize="12"
                                         FontFamily="Consolas"
                                         Padding="8"
                                         ToolTip="포함할 키워드를 한 줄에 하나씩 입력"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- Tips -->
                        <Border Background="#E8F5E9" BorderBrush="#81C784" BorderThickness="1" 
                                CornerRadius="5" Padding="15">
                            <StackPanel>
                                <TextBlock Text="💡 팁" FontWeight="Bold" Foreground="#2E7D32" Margin="0,0,0,8"/>
                                <TextBlock Text="• 불필요한 로그를 제외하면 파싱 속도가 향상됩니다." 
                                           Foreground="#388E3C" FontSize="11" Margin="0,0,0,3"/>
                                <TextBlock Text="• 포함 키워드는 대소문자를 구분하지 않습니다." 
                                           Foreground="#388E3C" FontSize="11" Margin="0,0,0,3"/>
                                <TextBlock Text="• 변경 후 로그를 다시 로드해야 적용됩니다." 
                                           Foreground="#F57C00" FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Bottom Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="초기화" Width="80" Height="32" Click="BtnReset_Click" FontSize="12"/>
            <Button Content="취소" Width="80" Height="32" Margin="10,0,0,0" Click="BtnCancel_Click" FontSize="12"/>
            <Button Content="적용" Width="100" Height="32" Margin="10,0,0,0" 
                    Background="#4CAF50" Foreground="White" FontWeight="Bold"
                    Click="BtnApply_Click" FontSize="12"/>
        </StackPanel>
    </Grid>
</Window>
