<Window x:Class="FACTOVA_MessageLogViewer.LogViewerWindow"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:local="clr-namespace:FACTOVA_MessageLogViewer.Converters"
Title="FACTOVA 통신 로그 뷰어" 
Height="800" 
Width="1600"
WindowStartupLocation="CenterScreen"
Background="#F5F5F5"
Loaded="Window_Loaded"
Closing="Window_Closing">

    <Window.Resources>
        <local:ReturnCodeColorConverter x:Key="ReturnCodeColorConverter"/>
        <local:ErrorColorConverter x:Key="ErrorColorConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="35"/>
        </Grid.RowDefinitions>

        <!-- 헤더 - 제목 및 주요 버튼 -->
        <Border Grid.Row="0" Background="#2196F3">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                    <TextBlock Text="📡 FACTOVA 통신 로그 뷰어" 
                               Foreground="White" 
                               FontSize="18" 
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtLogFolder"
                               Foreground="#E3F2FD" 
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="15,0,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Right" 
                            VerticalAlignment="Center"
                            Margin="15,0">

                    <!-- 프리셋 선택 -->
                    <TextBlock Text="Preset:" 
                               Foreground="White" 
                               VerticalAlignment="Center" 
                               Margin="0,0,5,0"
                               FontSize="11"/>
                    <ComboBox x:Name="cboPresets" 
                              Width="140" Height="24"
                              FontSize="11"
                              SelectionChanged="CboPresets_SelectionChanged"
                              ToolTip="Select preset to apply"/>

                    <!-- 설정 버튼 -->
                    <Button Content="⚙" 
                            Width="28" Height="24" 
                            Margin="3,0,15,0"
                            Click="BtnColumnSettings_Click"
                            Background="#1976D2"
                            Foreground="White"
                            BorderThickness="0"
                            FontSize="14"
                            Cursor="Hand"
                            ToolTip="Edit Settings"/>

                    <!-- 구분선 -->
                    <Border Width="1" Background="#64B5F6" Margin="0,5,15,5"/>

                    <!-- 폰트 크기 -->
                    <TextBlock Text="Font:" 
                               Foreground="White" 
                               VerticalAlignment="Center" 
                               Margin="0,0,5,0"
                               FontSize="11"/>
                    <TextBox x:Name="txtFontSize" 
                             Width="32" Height="24"
                             Text="11"
                             VerticalContentAlignment="Center"
                             HorizontalContentAlignment="Center"
                             FontSize="11"/>
                    <Button Content="-" Width="22" Height="24" Margin="3,0,0,0" Click="BtnFontMinus_Click" FontWeight="Bold"/>
                    <Button Content="+" Width="22" Height="24" Margin="3,0,8,0" Click="BtnFontPlus_Click" FontWeight="Bold"/>
                    
                    <!-- Auto Fit 버튼 -->
                    <Button Content="📐 Fit" 
                            Width="50" Height="24" 
                            Margin="0,0,15,0"
                            Click="BtnAutoFit_Click"
                            Background="#40FFFFFF"
                            Foreground="White"
                            BorderBrush="White"
                            BorderThickness="1"
                            FontSize="10"
                            Cursor="Hand"
                            ToolTip="컬럼을 컨텐츠에 맞게 자동 조정"/>

                    <!-- 구분선 -->
                    <Border Width="1" Background="#64B5F6" Margin="0,5,15,5"/>

                    <!-- 제어 버튼들 -->
                    <Button x:Name="btnPause" 
                            Content="⏸ 일시정지" 
                            Width="90" Height="28" 
                            Margin="0,0,8,0"
                            Click="BtnPause_Click"
                            Background="#40FFFFFF"
                            Foreground="White"
                            BorderBrush="White"
                            BorderThickness="1"
                            FontSize="12"
                            Cursor="Hand"/>

                    <Button Content="Clear" 
                            Width="60" Height="28" 
                            Click="BtnClear_Click"
                            Background="#40FFFFFF"
                            Foreground="White"
                            BorderBrush="White"
                            BorderThickness="1"
                            FontSize="12"
                            Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 필터 영역 -->
        <Border Grid.Row="1" Background="#E3F2FD">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                <TextBlock Text="🔍 검색:" 
                           Foreground="#1565C0" 
                           VerticalAlignment="Center" 
                           Margin="0,0,8,0"
                           FontSize="13"
                           FontWeight="SemiBold"/>

                <TextBox x:Name="txtSearch" 
                         Width="350" Height="28"
                         VerticalAlignment="Center"
                         VerticalContentAlignment="Center"
                         Padding="8,0"
                         FontSize="12"
                         TextChanged="TxtSearch_TextChanged">
                    <TextBox.ToolTip>
                        <ToolTip MaxWidth="450">
                            <StackPanel>
                                <TextBlock Text="🔍 복합 검색" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>

                                <Border Background="#F0F0F0" Padding="8" CornerRadius="3" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock FontWeight="Bold" Margin="0,0,0,3">
                                            <Run Text="구분자:"/>
                                        </TextBlock>
                                        <TextBlock Margin="5,0,0,2">
                                            <Run Text="쉼표(,)" FontFamily="Consolas" FontWeight="Bold"/>
                                            <Run Text=" → OR 검색 (또는)"/>
                                        </TextBlock>
                                        <TextBlock Margin="5,0,0,0">
                                            <Run Text="플러스(+)" FontFamily="Consolas" FontWeight="Bold"/>
                                            <Run Text=" → AND 검색 (그리고)"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="📝 예시:" FontWeight="Bold" Margin="0,0,0,5"/>

                                <TextBlock Margin="5,0,0,3">
                                    <Run Text="OK+1234" FontFamily="Consolas" FontWeight="Bold" Foreground="#1976D2"/>
                                    <Run Text=" → OK 그리고 1234 포함" Foreground="#666" FontSize="11"/>
                                </TextBlock>

                                <TextBlock Margin="5,0,0,3">
                                    <Run Text="OK,NG" FontFamily="Consolas" FontWeight="Bold" Foreground="#1976D2"/>
                                    <Run Text=" → OK 또는 NG 포함" Foreground="#666" FontSize="11"/>
                                </TextBlock>

                                <TextBlock Margin="5,0,0,0">
                                    <Run Text="송신+NG,수신+OK" FontFamily="Consolas" FontWeight="Bold" Foreground="#1976D2"/>
                                    <Run Text=" → (송신 AND NG) OR (수신 AND OK)" Foreground="#666" FontSize="11"/>
                                </TextBlock>
                            </StackPanel>
                        </ToolTip>
                    </TextBox.ToolTip>
                </TextBox>

                <TextBlock Text="ⓘ" 
                           Foreground="#1976D2" 
                           VerticalAlignment="Center" 
                           Margin="5,0,20,0"
                           FontSize="14"
                           FontWeight="Bold"
                           Cursor="Help"
                           ToolTip="쉼표(,)=OR, 플러스(+)=AND&#x0a;예: OK+1234,NG"/>

                <!-- 구분선 -->
                <Border Width="1" Background="#90CAF9" Margin="0,8,20,8"/>

                <!-- 방향 필터 -->
                <Border Background="White" CornerRadius="4" Padding="10,4" BorderBrush="#90CAF9" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <CheckBox x:Name="chkSendOnly" 
                                  Content="📤 송신만" 
                                  Foreground="#1565C0"
                                  VerticalAlignment="Center" 
                                  Margin="0,0,15,0"
                                  FontSize="12"
                                  Checked="Filter_Changed" 
                                  Unchecked="Filter_Changed"/>

                        <CheckBox x:Name="chkRecvOnly" 
                                  Content="📥 수신만" 
                                  Foreground="#1565C0"
                                  VerticalAlignment="Center"
                                  FontSize="12"
                                  Checked="Filter_Changed" 
                                  Unchecked="Filter_Changed"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- TabControl with ListView -->
        <TabControl Grid.Row="2" 
                    x:Name="tabControlLogs"
                    Margin="10"
                    SelectionChanged="TabControlLogs_SelectionChanged">
            
            <!-- 탭들은 코드에서 동적으로 생성됨 -->
            
        </TabControl>

        <!-- 하단 상태바 -->
        <Border Grid.Row="3" Background="#EEEEEE" BorderBrush="#CCCCCC" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock x:Name="txtStatus" 
                           Text="로그 개수: 0" 
                           VerticalAlignment="Center" 
                           Margin="15,0"
                           FontSize="12"
                           Foreground="#333"/>

                <TextBlock x:Name="txtMode" 
                           Text="" 
                           VerticalAlignment="Center" 
                           HorizontalAlignment="Right"
                           Margin="15,0"
                           FontSize="11"
                           Foreground="#666"/>
            </Grid>
        </Border>
    </Grid>
</Window>
