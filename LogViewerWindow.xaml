<Window x:Class="FACTOVA_MessageLogViewer.LogViewerWindow"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:local="clr-namespace:FACTOVA_MessageLogViewer.Converters"
Title="FACTOVA 통신 로그 뷰어" 
Height="800" 
Width="1600"
WindowStartupLocation="CenterScreen"
Background="#F5F5F5"
Loaded="Window_Loaded"
Closing="Window_Closing">

    <Window.Resources>
        <local:ReturnCodeColorConverter x:Key="ReturnCodeColorConverter"/>
        <local:ErrorColorConverter x:Key="ErrorColorConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="35"/>
        </Grid.RowDefinitions>

        <!-- 헤더 - 제목 및 주요 버튼 -->
        <Border Grid.Row="0" Background="#2196F3">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                    <TextBlock Text="📡 FACTOVA 통신 로그 뷰어" 
                               Foreground="White" 
                               FontSize="18" 
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtLogFolder"
                               Foreground="#E3F2FD" 
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="15,0,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Right" 
                            VerticalAlignment="Center"
                            Margin="15,0">

                    <!-- 폰트 크기 -->
                    <TextBlock Text="Font:" 
                               Foreground="White" 
                               VerticalAlignment="Center" 
                               Margin="0,0,5,0"
                               FontSize="11"/>
                    <TextBox x:Name="txtFontSize" 
                             Width="32" Height="24"
                             Text="11"
                             VerticalContentAlignment="Center"
                             HorizontalContentAlignment="Center"
                             FontSize="11"/>
                    <Button Content="-" Width="22" Height="24" Margin="3,0,0,0" Click="BtnFontMinus_Click" FontWeight="Bold"/>
                    <Button Content="+" Width="22" Height="24" Margin="3,0,8,0" Click="BtnFontPlus_Click" FontWeight="Bold"/>
                    
                    <!-- Auto Fit 버튼 -->
                    <Button Content="📐 Fit" 
                            Width="50" Height="24" 
                            Margin="0,0,15,0"
                            Click="BtnAutoFit_Click"
                            Background="#40FFFFFF"
                            Foreground="White"
                            BorderBrush="White"
                            BorderThickness="1"
                            FontSize="10"
                            Cursor="Hand"
                            ToolTip="컬럼을 컨텐츠에 맞게 자동 조정"/>

                    <!-- 구분선 -->
                    <Border Width="1" Background="#64B5F6" Margin="0,5,15,5"/>

                    <!-- 제어 버튼들 -->
                    <Button x:Name="btnPause" 
                            Content="⏸ 일시정지" 
                            Width="90" Height="28" 
                            Margin="0,0,8,0"
                            Click="BtnPause_Click"
                            Background="#40FFFFFF"
                            Foreground="White"
                            BorderBrush="White"
                            BorderThickness="1"
                            FontSize="12"
                            Cursor="Hand"/>

                    <Button Content="Clear" 
                            Width="60" Height="28" 
                            Click="BtnClear_Click"
                            Background="#40FFFFFF"
                            Foreground="White"
                            BorderBrush="White"
                            BorderThickness="1"
                            FontSize="12"
                            Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 설정 영역 (Expander) -->
        <Expander Grid.Row="1" 
                  x:Name="expanderSettings"
                  Header="⚙️ 로그 설정"
                  IsExpanded="True"
                  Background="White"
                  BorderBrush="#CCCCCC"
                  BorderThickness="0,1,0,1"
                  Padding="15,10">
            <StackPanel Margin="10">
                <!-- 로그 폴더 선택 -->
                <GroupBox Header="📁 로그 폴더" FontSize="13" Margin="0,0,0,10">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBox x:Name="txtLogFolderPath" 
                                     Grid.Column="0"
                                     Height="32"
                                     IsReadOnly="True" 
                                     VerticalContentAlignment="Center"
                                     Padding="8"
                                     FontSize="11"
                                     FontFamily="Consolas"
                                     Background="#FAFAFA"
                                     Margin="0,0,10,0"/>
                            <Button Grid.Column="1"
                                    Content="기본폴더" 
                                    Width="90" 
                                    Height="32"
                                    FontSize="11"
                                    Margin="0,0,5,0"
                                    Click="BtnSetDefaultFolder_Click"
                                    ToolTip="기본 폴더로 설정"/>
                            <Button Grid.Column="2"
                                    Content="폴더 선택" 
                                    Width="90" 
                                    Height="32"
                                    FontSize="11"
                                    Click="BtnBrowse_Click"
                                    ToolTip="사용자 폴더 선택"/>
                        </Grid>
                        <TextBlock Text="기본폴더: 년/월 구조 자동 검색 | 사용자폴더: 해당 폴더 내 로그 검색"
                                   Foreground="#666"
                                   FontSize="10"
                                   Margin="0,5,0,0"/>
                    </StackPanel>
                </GroupBox>

                <!-- 프리셋 선택 -->
                <GroupBox Header="🎨 프리셋 선택" FontSize="13" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="저장된 컬럼 설정과 탭 필터를 불러올 수 있습니다."
                                   Foreground="#666"
                                   FontSize="10"
                                   Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="프리셋:" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12"/>
                            <ComboBox x:Name="cboPresets" 
                                      Width="250"
                                      Height="28"
                                      FontSize="12"
                                      SelectionChanged="CboPresets_SelectionChanged"
                                      ToolTip="저장된 프리셋을 선택하세요"/>
                            <Button Content="⚙ 프리셋 편집" 
                                    Width="110" 
                                    Height="32"
                                    FontSize="11"
                                    Margin="10,0,0,0"
                                    Click="BtnColumnSettings_Click"
                                    Background="#1976D2"
                                    Foreground="White"
                                    Cursor="Hand"
                                    ToolTip="프리셋 생성, 수정, 삭제"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- 날짜 선택 -->
                <GroupBox Header="📅 로그 날짜 선택" FontSize="13" Margin="0,0,0,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="날짜:" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12"/>
                            <ComboBox x:Name="cboAvailableDates" 
                                      Width="200"
                                      Height="28"
                                      FontSize="12"
                                      DisplayMemberPath="DisplayText"
                                      SelectedValuePath="Date"/>
                            <Button Content="새로고침" 
                                    Width="80" 
                                    Height="32"
                                    Margin="10,0,0,0"
                                    Click="BtnRefreshDates_Click"
                                    FontSize="11"/>
                            <Button Content="로그 다시 로드" 
                                    Width="120" 
                                    Height="32"
                                    Margin="10,0,0,0"
                                    Background="#4CAF50"
                                    Foreground="White"
                                    Click="BtnReloadLog_Click"
                                    FontSize="11"/>
                        </StackPanel>
                        <TextBlock x:Name="txtDateInfo"
                                   Text="폴더에서 로그 파일을 검색합니다."
                                   Foreground="#666"
                                   FontSize="10"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </GroupBox>

                <!-- 로그 표시 옵션 -->
                <GroupBox Header="⚙ 로그 표시 옵션" FontSize="13">
                    <StackPanel>
                        <RadioButton x:Name="rbNewOnly" 
                                     Content="📍 실행 시점 이후 로그만 표시 (추천 - 빠른 시작)"
                                     IsChecked="True"
                                     Margin="0,5"
                                     FontSize="12"
                                     FontWeight="Bold"/>
                        <TextBlock Text="   → 기존 로그는 무시하고 프로그램 실행 후 발생하는 로그만 표시합니다."
                                   Foreground="#666"
                                   FontSize="11"
                                   Margin="0,0,0,10"
                                   TextWrapping="Wrap"/>

                        <RadioButton x:Name="rbLoadRecent" 
                                     Content="📚 최근 로그 로드"
                                     FontSize="12"
                                     Margin="0,5"/>
                        <StackPanel Orientation="Horizontal" Margin="20,5,0,10">
                            <TextBlock Text="개수:" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12"/>
                            <TextBox x:Name="txtRecentCount" 
                                     Width="100" 
                                     Height="26"
                                     FontSize="12"
                                     Text="1000" 
                                     VerticalContentAlignment="Center"
                                     IsEnabled="{Binding IsChecked, ElementName=rbLoadRecent}"/>
                            <TextBlock Text="개 (기본: 1000개)" 
                                       VerticalAlignment="Center" 
                                       FontSize="11"
                                       Margin="10,0,0,0"
                                       Foreground="#666"/>
                        </StackPanel>
                        
                        <!-- 시작 버튼 -->
                        <Button Content="🚀 로그 뷰어 시작" 
                                Width="200" 
                                Height="40"
                                FontSize="14"
                                FontWeight="Bold"
                                Background="#4CAF50"
                                Foreground="White"
                                BorderThickness="0"
                                Margin="0,15,0,5"
                                HorizontalAlignment="Center"
                                Click="BtnStartViewer_Click"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="5"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" 
                                                                     VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#45A049"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </Expander>

        <!-- 필터 영역 -->
        <Border Grid.Row="2" Background="#E3F2FD">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                <TextBlock Text="🔍 검색:" 
                           Foreground="#1565C0" 
                           VerticalAlignment="Center" 
                           Margin="0,0,8,0"
                           FontSize="13"
                           FontWeight="SemiBold"/>

                <TextBox x:Name="txtSearch" 
                         Width="350" Height="28"
                         VerticalAlignment="Center"
                         VerticalContentAlignment="Center"
                         Padding="8,0"
                         FontSize="12"
                         TextChanged="TxtSearch_TextChanged">
                    <TextBox.ToolTip>
                        <ToolTip MaxWidth="450">
                            <StackPanel>
                                <TextBlock Text="🔍 복합 검색" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>

                                <Border Background="#F0F0F0" Padding="8" CornerRadius="3" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock FontWeight="Bold" Margin="0,0,0,3">
                                            <Run Text="구분자:"/>
                                        </TextBlock>
                                        <TextBlock Margin="5,0,0,2">
                                            <Run Text="쉼표(,)" FontFamily="Consolas" FontWeight="Bold"/>
                                            <Run Text=" → OR 검색 (또는)"/>
                                        </TextBlock>
                                        <TextBlock Margin="5,0,0,0">
                                            <Run Text="플러스(+)" FontFamily="Consolas" FontWeight="Bold"/>
                                            <Run Text=" → AND 검색 (그리고)"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="📝 예시:" FontWeight="Bold" Margin="0,0,0,5"/>

                                <TextBlock Margin="5,0,0,3">
                                    <Run Text="OK+1234" FontFamily="Consolas" FontWeight="Bold" Foreground="#1976D2"/>
                                    <Run Text=" → OK 그리고 1234 포함" Foreground="#666" FontSize="11"/>
                                </TextBlock>

                                <TextBlock Margin="5,0,0,3">
                                    <Run Text="OK,NG" FontFamily="Consolas" FontWeight="Bold" Foreground="#1976D2"/>
                                    <Run Text=" → OK 또는 NG 포함" Foreground="#666" FontSize="11"/>
                                </TextBlock>

                                <TextBlock Margin="5,0,0,0">
                                    <Run Text="송신+NG,수신+OK" FontFamily="Consolas" FontWeight="Bold" Foreground="#1976D2"/>
                                    <Run Text=" → (송신 AND NG) OR (수신 AND OK)" Foreground="#666" FontSize="11"/>
                                </TextBlock>
                            </StackPanel>
                        </ToolTip>
                    </TextBox.ToolTip>
                </TextBox>

                <TextBlock Text="ⓘ" 
                           Foreground="#1976D2" 
                           VerticalAlignment="Center" 
                           Margin="5,0,20,0"
                           FontSize="14"
                           FontWeight="Bold"
                           Cursor="Help"
                           ToolTip="쉼표(,)=OR, 플러스(+)=AND&#x0a;예: OK+1234,NG"/>

                <!-- 구분선 -->
                <Border Width="1" Background="#90CAF9" Margin="0,8,20,8"/>

                <!-- 방향 필터 -->
                <Border Background="White" CornerRadius="4" Padding="10,4" BorderBrush="#90CAF9" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <CheckBox x:Name="chkSendOnly" 
                                  Content="📤 송신만" 
                                  Foreground="#1565C0"
                                  VerticalAlignment="Center" 
                                  Margin="0,0,15,0"
                                  FontSize="12"
                                  Checked="Filter_Changed" 
                                  Unchecked="Filter_Changed"/>

                        <CheckBox x:Name="chkRecvOnly" 
                                  Content="📥 수신만" 
                                  Foreground="#1565C0"
                                  VerticalAlignment="Center"
                                  FontSize="12"
                                  Checked="Filter_Changed" 
                                  Unchecked="Filter_Changed"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- TabControl with ListView -->
        <TabControl Grid.Row="3" 
                    x:Name="tabControlLogs"
                    Margin="10"
                    SelectionChanged="TabControlLogs_SelectionChanged">
            
            <!-- 탭들은 코드에서 동적으로 생성됨 -->
            
        </TabControl>

        <!-- 하단 상태바 -->
        <Border Grid.Row="4" Background="#EEEEEE" BorderBrush="#CCCCCC" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock x:Name="txtStatus" 
                           Text="로그 개수: 0" 
                           VerticalAlignment="Center" 
                           Margin="15,0"
                           FontSize="12"
                           Foreground="#333"/>

                <TextBlock x:Name="txtMode" 
                           Text="" 
                           VerticalAlignment="Center" 
                           HorizontalAlignment="Right"
                           Margin="15,0"
                           FontSize="11"
                           Foreground="#666"/>
            </Grid>
        </Border>
    </Grid>
</Window>
