<Window x:Class="FACTOVA_MessageLogViewer.FLTagItemEditPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="값 필터 설정"
        Height="280" Width="450"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5"
        ResizeMode="CanResize"
        MinHeight="280" MinWidth="400">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 태그명 표시 -->
        <TextBlock Grid.Row="0" Text="태그명:" FontWeight="SemiBold" Margin="0,0,0,5"/>
        <TextBox Grid.Row="1" Text="{Binding TagName}" FontFamily="Consolas" 
                 IsReadOnly="True" Background="#F0F0F0" BorderBrush="#CCC"
                 Padding="8,5" Margin="0,0,0,10" Height="32" VerticalContentAlignment="Center"/>

        <!-- 값 필터 -->
        <TextBlock Grid.Row="2" Text="값 필터 (빈 값 = 모든 값):" FontWeight="SemiBold" Margin="0,0,0,5"/>
        <TextBlock Grid.Row="3" Text="로그에서 발견된 값을 선택하거나 직접 입력하세요" 
                   FontSize="11" Foreground="#888" Margin="0,0,0,8" TextWrapping="Wrap"/>
        
        <ComboBox Grid.Row="4" x:Name="cboValueFilter" 
                  Height="34" FontSize="13" Padding="8,0"
                  IsEditable="True"
                  VerticalContentAlignment="Center"
                  Margin="0,0,0,10"/>

        <!-- 빈 공간 -->
        <Border Grid.Row="5"/>

        <!-- 버튼 -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="확인" Width="90" Height="34" Click="BtnOK_Click" IsDefault="True"
                    Background="#9C27B0" Foreground="White" FontWeight="Bold" FontSize="13"/>
            <Button Content="취소" Width="90" Height="34" Margin="10,0,0,0" Click="BtnCancel_Click" IsCancel="True"
                    FontSize="13"/>
        </StackPanel>
    </Grid>
</Window>
