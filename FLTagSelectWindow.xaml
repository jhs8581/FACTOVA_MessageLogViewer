<Window x:Class="FACTOVA_MessageLogViewer.FLTagSelectWindow"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
Title="태그 선택" 
Height="500" Width="500"
WindowStartupLocation="CenterOwner"
Background="#F5F5F5">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="추가할 태그를 선택하세요" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBox x:Name="txtFilter" Width="300" Height="28" 
                     VerticalContentAlignment="Center" Padding="8,0"
                     TextChanged="TxtFilter_TextChanged"
                     ToolTip="태그명 필터"/>
            <Button Content="전체선택" Width="70" Height="28" Margin="10,0,0,0" Click="BtnSelectAll_Click"/>
            <Button Content="전체해제" Width="70" Height="28" Margin="5,0,0,0" Click="BtnDeselectAll_Click"/>
        </StackPanel>

        <ListBox Grid.Row="2" 
                 x:Name="listBoxTags"
                 Background="White"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border Background="Transparent" Padding="5,3">
                                    <ContentPresenter/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" 
                              VerticalAlignment="Center">
                        <TextBlock Text="{Binding TagName}" 
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   VerticalAlignment="Center"/>
                    </CheckBox>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <TextBlock x:Name="txtSelectedCount" Text="선택: 0개" VerticalAlignment="Center" Margin="0,0,15,0" Foreground="#666"/>
            <Button Content="확인" Width="80" Height="32" Click="BtnOk_Click"
                    Background="#9C27B0" Foreground="White" FontWeight="Bold"/>
            <Button Content="취소" Width="80" Height="32" Margin="10,0,0,0" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
