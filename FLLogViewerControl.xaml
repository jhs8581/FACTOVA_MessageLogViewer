<UserControl x:Class="FACTOVA_MessageLogViewer.FLLogViewerControl"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:converters="clr-namespace:FACTOVA_MessageLogViewer.Converters"
Background="#F5F5F5"
Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <!-- Value ON/OFF 색상 컨버터 -->
        <converters:FLValueColorConverter x:Key="FLValueColorConverter"/>

        <!-- DataGrid 스크롤 최적화 스타일 -->
        <Style TargetType="DataGrid">
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Item"/>
            <Setter Property="VirtualizingPanel.CacheLength" Value="10"/>
            <Setter Property="VirtualizingPanel.CacheLengthUnit" Value="Item"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="ScrollViewer.IsDeferredScrollingEnabled" Value="False"/>
        </Style>
        
        <!-- 하위 탭 스타일 (다른 화면과 동일) -->
        <Style x:Key="SubTabStyle" TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Border" 
                                Background="#F5F5F5" 
                                BorderThickness="1,1,1,0"
                                BorderBrush="#DDDDDD"
                                CornerRadius="4,4,0,0"
                                Margin="1,0,0,0"
                                Padding="15,8">
                            <ContentPresenter x:Name="ContentSite"
                                              ContentSource="Header"
                                              HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="White"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#9C27B0"/>
                                <Setter TargetName="Border" Property="BorderThickness" Value="1,2,1,0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#EEEEEE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="#444444"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="75"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="35"/>
        </Grid.RowDefinitions>

        <!-- 헤더 - 제목 및 주요 버튼 -->
        <Border Grid.Row="0" Background="#9C27B0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                    <TextBlock Text="🏭 F/L 로그" 
                               Foreground="White" 
                               FontSize="16" 
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtLogFolder"
                               Foreground="#E1BEE7" 
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="15,0,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Right" 
                            VerticalAlignment="Center"
                            Margin="15,0">

                    <!-- 폰트 크기 -->
                    <TextBlock Text="Font:" 
                               Foreground="White" 
                               VerticalAlignment="Center" 
                               Margin="0,0,5,0"
                               FontSize="11"/>
                    <TextBox x:Name="txtFontSize" 
                             Width="32" Height="24"
                             Text="11"
                             VerticalContentAlignment="Center"
                             HorizontalContentAlignment="Center"
                             FontSize="11"/>
                    <Button Content="-" Width="22" Height="24" Margin="3,0,0,0" Click="BtnFontMinus_Click" FontWeight="Bold"/>
                    <Button Content="+" Width="22" Height="24" Margin="3,0,8,0" Click="BtnFontPlus_Click" FontWeight="Bold"/>

                    <!-- Auto Fit 버튼 -->
                    <Button Content="📐 Fit" 
                            Width="50" Height="24" 
                            Margin="0,0,15,0"
                            Click="BtnAutoFit_Click"
                            Background="#40FFFFFF"
                            Foreground="White"
                            BorderBrush="White"
                            BorderThickness="1"
                            FontSize="10"
                            Cursor="Hand"
                            ToolTip="컬럼을 컨텐츠에 맞게 자동 조정"/>

                    <!-- 구분선 -->
                    <Border Width="1" Background="#CE93D8" Margin="0,5,15,5"/>

                    <!-- 제어 버튼들 -->
                    <Button Content="Clear" 
                            Width="60" Height="28" 
                            Margin="0,0,8,0"
                            Click="BtnClear_Click"
                            Background="#40FFFFFF"
                            Foreground="White"
                            BorderBrush="White"
                            BorderThickness="1"
                            FontSize="12"
                            Cursor="Hand"/>

                    <Button x:Name="btnAutoScroll"
                            Content="⬇ 자동스크롤" 
                            Width="100" Height="28" 
                            Margin="0,0,8,0"
                            Click="BtnAutoScroll_Click"
                            Background="#4CAF50"
                            Foreground="White"
                            BorderBrush="White"
                            BorderThickness="1"
                            FontSize="11"
                            Cursor="Hand"
                            ToolTip="자동 스크롤 ON/OFF"/>

                    <Button Content="📊 Excel" 
                            Width="70" Height="28" 
                            Click="BtnExportExcel_Click"
                            Background="#4CAF50"
                            Foreground="White"
                            BorderBrush="White"
                            BorderThickness="1"
                            FontSize="12"
                            Cursor="Hand"
                            ToolTip="로그를 엑셀로 다운로드"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 필터 영역 -->
        <Border Grid.Row="1" Background="#F3E5F5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- 첫 번째 줄 -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                    <TextBlock Text="🔍 검색:" 
                               Foreground="#7B1FA2" 
                               VerticalAlignment="Center" 
                               Margin="0,0,8,0"
                               FontSize="13"
                               FontWeight="SemiBold"/>

                    <TextBox x:Name="txtSearch" 
                             Width="300" Height="26"
                             VerticalAlignment="Center"
                             VerticalContentAlignment="Center"
                             Padding="8,0"
                             FontSize="12"
                             KeyDown="TxtSearch_KeyDown"
                             ToolTip="태그명, 값 등 검색 (쉼표=OR, 플러스=AND)"/>

                    <Button Content="🔍" 
                            Width="32" Height="26"
                            Margin="5,0,0,0"
                            Click="BtnSearch_Click"
                            Background="#9C27B0"
                            Foreground="White"
                            FontSize="14"
                            Cursor="Hand"
                            ToolTip="검색 (Enter)"/>
                    
                    <!-- 구분선 -->
                    <Border Width="1" Background="#CE93D8" Margin="20,6,20,6"/>
                    
                    <!-- 타입 필터 -->
                    <Border Background="White" CornerRadius="4" Padding="8,2" BorderBrush="#4CAF50" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="타입:" 
                                       Foreground="#2E7D32" 
                                       VerticalAlignment="Center" 
                                       Margin="0,0,8,0"
                                       FontSize="11"
                                       FontWeight="SemiBold"/>
                            <ComboBox x:Name="cboTypeFilter" 
                                      Width="90" Height="22"
                                      FontSize="11"
                                      VerticalContentAlignment="Center"
                                      SelectionChanged="CboTypeFilter_SelectionChanged"
                                      ToolTip="데이터 타입 필터">
                                <ComboBoxItem Content="전체" IsSelected="True"/>
                                <ComboBoxItem Content="📦 Structure"/>
                                <ComboBoxItem Content="🔘 Boolean"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>
                    
                    <!-- 구분선 -->
                    <Border Width="1" Background="#CE93D8" Margin="20,6,20,6"/>
                    
                    <!-- ON/OFF 필터 -->
                    <Border Background="White" CornerRadius="4" Padding="8,2" BorderBrush="#9C27B0" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="값:" 
                                       Foreground="#7B1FA2" 
                                       VerticalAlignment="Center" 
                                       Margin="0,0,8,0"
                                       FontSize="11"
                                       FontWeight="SemiBold"/>
                            <ComboBox x:Name="cboValueFilter" 
                                      Width="70" Height="22"
                                      FontSize="11"
                                      VerticalContentAlignment="Center"
                                      SelectionChanged="CboValueFilter_SelectionChanged"
                                      ToolTip="값 필터">
                                <ComboBoxItem Content="전체" IsSelected="True"/>
                                <ComboBoxItem Content="ON"/>
                                <ComboBoxItem Content="OFF"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <!-- 구분선 -->
                    <Border Width="1" Background="#CE93D8" Margin="20,6,20,6"/>

                    <!-- 시간대 필터 -->
                    <Border Background="White" CornerRadius="4" Padding="8,2" BorderBrush="#FF9800" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⏰ 시간대:" 
                                       Foreground="#E65100" 
                                       VerticalAlignment="Center" 
                                       Margin="0,0,8,0"
                                       FontSize="11"
                                       FontWeight="SemiBold"/>
                            <ComboBox x:Name="cboHourFilter" 
                                      Width="70" Height="22"
                                      FontSize="11"
                                      VerticalContentAlignment="Center"
                                      SelectionChanged="CboHourFilter_SelectionChanged"
                                      ToolTip="시간대 필터 (로드된 파일 기준)">
                                <ComboBoxItem Content="전체" IsSelected="True"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>
                    
                    <!-- 구분선 -->
                    <Border Width="1" Background="#CE93D8" Margin="20,6,20,6"/>
                    
                    <!-- 파일 수 표시 -->
                    <TextBlock x:Name="txtFileCount" 
                               Text="파일: 0개" 
                               Foreground="#7B1FA2" 
                               VerticalAlignment="Center" 
                               FontSize="11"
                               FontWeight="SemiBold"/>
                </StackPanel>
                
                <!-- 두 번째 줄: 태그 필터 -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                    <!-- 태그 필터 (멀티선택) -->
                    <Border Background="White" CornerRadius="4" Padding="8,2" BorderBrush="#2196F3" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🏷 태그:" 
                                       FontSize="11" 
                                       VerticalAlignment="Center" 
                                       Margin="0,0,8,0" 
                                       Foreground="#1565C0" 
                                       FontWeight="SemiBold"/>
                            <Button Content="✓" Width="20" Height="20" Margin="0,0,3,0" 
                                    Click="BtnTagSelectAll_Click" 
                                    ToolTip="전체 선택" 
                                    FontSize="9" FontWeight="Bold"
                                    Background="#E8F5E9" Foreground="#2E7D32" BorderBrush="#A5D6A7" Cursor="Hand"/>
                            <Button Content="✗" Width="20" Height="20" Margin="0,0,5,0" 
                                    Click="BtnTagDeselectAll_Click" 
                                    ToolTip="전체 해제"
                                    FontSize="9" FontWeight="Bold"
                                    Background="#FFEBEE" Foreground="#C62828" BorderBrush="#EF9A9A" Cursor="Hand"/>
                            <ComboBox x:Name="cboTagFilter" Width="350" Height="22" FontSize="11" 
                                      IsEditable="True" IsReadOnly="True" Text="전체"
                                      DropDownOpened="CboTagFilter_DropDownOpened">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" 
                                                  Click="TagFilterCheckBox_Click">
                                            <TextBlock Text="{Binding Name}"/>
                                        </CheckBox>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- TabControl with DataGrid -->
        <TabControl Grid.Row="2" 
                    x:Name="tabControlLogs"
                    Margin="10"
                    Background="White"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    ItemContainerStyle="{StaticResource SubTabStyle}"
                    SelectionChanged="TabControlLogs_SelectionChanged">
            
            <!-- 탭들은 코드에서 동적으로 생성됨 -->
            
        </TabControl>

        <!-- 로딩 프로그레스바 (오버레이) -->
        <Border x:Name="loadingOverlay" 
                Grid.Row="2" 
                Background="#CC000000"
                Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="📂 로그 파일을 읽는 중..."
                           Foreground="White"
                           FontSize="18"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,15"/>

                <ProgressBar x:Name="progressBar"
                             Width="400"
                             Height="30"
                             IsIndeterminate="True"
                             Foreground="#9C27B0"/>

                <TextBlock x:Name="txtLoadingStatus"
                           Text=""
                           Foreground="#E0E0E0"
                           FontSize="13"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,0"/>
            </StackPanel>
        </Border>

        <!-- 하단 상태바 -->
        <Border Grid.Row="3" Background="#EEEEEE" BorderBrush="#CCCCCC" BorderThickness="0,1,0,0" Padding="15,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="txtStatus" Text="준비" Foreground="#333" FontSize="12"/>
                    <TextBlock x:Name="txtCount" Text=" | 전체: 0건" Foreground="#7B1FA2" FontSize="12" Margin="10,0,0,0"/>
                    <TextBlock x:Name="txtFilteredCount" Text=" | 필터: 0건" Foreground="#666" FontSize="12" Margin="5,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="txtDirectory" Foreground="#666" FontSize="11" FontFamily="Consolas"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
