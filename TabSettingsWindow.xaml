<Window x:Class="FACTOVA_MessageLogViewer.TabSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tab Settings" 
        Height="600" 
        Width="800"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Tab Settings" FontSize="18" FontWeight="Bold" Foreground="#333"/>
            <TextBlock Text="Configure tabs to filter logs by MessageId or field values." 
                       FontSize="12" Foreground="#666" Margin="0,5,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="#DDD" BorderThickness="1" CornerRadius="5" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Tab List" FontWeight="Bold" Margin="10" Foreground="#555"/>

                    <ListBox Grid.Row="1" 
                             x:Name="listBoxTabs"
                             Margin="5"
                             SelectionChanged="ListBoxTabs_SelectionChanged"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" 
                                              IsChecked="{Binding IsEnabled}" 
                                              VerticalAlignment="Center"
                                              Margin="0,0,8,0"
                                              Checked="TabEnabled_Changed"
                                              Unchecked="TabEnabled_Changed"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding ConditionSummary}" 
                                                   FontSize="10" Foreground="#888"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="10">
                        <Button Content="+ Add" Width="60" Height="28" Click="BtnAddTab_Click" Margin="0,0,5,0"/>
                        <Button Content="Delete" Width="60" Height="28" Click="BtnRemoveTab_Click" Margin="0,0,5,0"/>
                        <Button Content="Up" Width="35" Height="28" Click="BtnMoveUp_Click" ToolTip="Move Up"/>
                        <Button Content="Dn" Width="35" Height="28" Click="BtnMoveDown_Click" ToolTip="Move Down"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="White" BorderBrush="#DDD" BorderThickness="1" CornerRadius="5">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="panelTabDetails" Margin="15">
                        <TextBlock Text="Tab Details" FontWeight="Bold" FontSize="14" Margin="0,0,0,15"/>

                        <TextBlock Text="Tab Name:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtTabName" 
                                 Height="30" 
                                 Padding="8,5"
                                 TextChanged="TxtTabName_TextChanged"/>

                        <CheckBox x:Name="chkIsIntegrated" 
                                  Content="Integrated Log Tab (Show All Logs)"
                                  Margin="0,15,0,0"
                                  Checked="ChkIsIntegrated_Changed"
                                  Unchecked="ChkIsIntegrated_Changed"/>

                        <TextBlock Text="Condition Groups (OR between groups):" FontWeight="SemiBold" Margin="0,20,0,5"/>
                        <TextBlock Text="Groups are OR. Conditions in a group are AND." 
                                   FontSize="11" Foreground="#888" Margin="0,0,0,10"/>

                        <ItemsControl x:Name="itemsConditionGroups">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F0F7FF" BorderBrush="#90CAF9" BorderThickness="1" 
                                            CornerRadius="5" Padding="10" Margin="0,0,0,10">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,8">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Group:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" 
                                                             Width="150" Height="26" Padding="5,3"
                                                             ToolTip="Group name (optional)"/>
                                                </StackPanel>
                                                <Button Content="Delete Group" 
                                                        HorizontalAlignment="Right"
                                                        Width="90" Height="26"
                                                        Background="#FFCDD2"
                                                        Click="BtnRemoveGroup_Click"
                                                        Tag="{Binding}"/>
                                            </Grid>

                                            <ItemsControl ItemsSource="{Binding Conditions}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" 
                                                                CornerRadius="3" Padding="8" Margin="0,0,0,5">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="Field:" Width="40" VerticalAlignment="Center"/>
                                                                    <ComboBox Width="120" 
                                                                              Text="{Binding FieldName, UpdateSourceTrigger=PropertyChanged}"
                                                                              IsEditable="True"
                                                                              ItemsSource="{Binding FieldList, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                    <TextBlock Text="Value:" Width="45" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                                                    <TextBox Width="120" 
                                                                             Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                                             ToolTip="Multiple values: comma separated"/>
                                                                    <CheckBox Content="Exact" 
                                                                              IsChecked="{Binding ExactMatch}"
                                                                              VerticalAlignment="Center" Margin="10,0,0,0"/>
                                                                </StackPanel>

                                                                <Button Grid.Column="1" Content="X" 
                                                                        Width="22" Height="22"
                                                                        Click="BtnRemoveConditionInGroup_Click"
                                                                        Tag="{Binding}"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <Button Content="+ Add Condition (AND)" 
                                                    Width="140" Height="26" 
                                                    HorizontalAlignment="Left"
                                                    Margin="0,5,0,0"
                                                    Click="BtnAddConditionToGroup_Click"
                                                    Tag="{Binding}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Content="+ Add Group (OR)" 
                                Width="130" 
                                Height="28" 
                                HorizontalAlignment="Left"
                                Margin="0,5,0,0"
                                Background="#E3F2FD"
                                Click="BtnAddGroup_Click"/>

                        <Border Background="#FFF3E0" BorderBrush="#FFB74D" BorderThickness="1" 
                                CornerRadius="5" Padding="12" Margin="0,20,0,0">
                            <StackPanel>
                                <TextBlock Text="Example: Scan Area" FontWeight="Bold" Foreground="#E65100" Margin="0,0,0,8"/>
                                <TextBlock FontSize="12" Foreground="#333" TextWrapping="Wrap">
                                    <Run FontWeight="SemiBold">Group 1:</Run>
                                    <Run>MSGID=2000 AND POSITION=01</Run>
                                    <LineBreak/>
                                    <Run FontWeight="SemiBold">Group 2:</Run>
                                    <Run>MSGID=1100 AND DOOR_LOAD=1,2</Run>
                                    <LineBreak/>
                                    <LineBreak/>
                                    <Run>= (MSGID=2000 AND POSITION=01)</Run>
                                    <Run FontWeight="Bold"> OR </Run>
                                    <Run>(MSGID=1100 AND DOOR_LOAD=1,2)</Run>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Cancel" Width="80" Height="32" Margin="0,0,10,0" Click="BtnCancel_Click"/>
            <Button Content="Save" Width="80" Height="32" 
                    Background="#4CAF50" Foreground="White" FontWeight="Bold"
                    Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>
