<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    
    <!-- 버전 정보 -->
    <Version>1.1.1</Version>
    <AssemblyVersion>1.1.1.0</AssemblyVersion>
    <FileVersion>1.1.1.0</FileVersion>
    
    <!-- 어플리케이션 정보 -->
    <Product>FACTOVA Message Log Viewer</Product>
    <Company>FACTOVA</Company>
    <Authors>FACTOVA IT Team</Authors>
    <Description>FACTOVA 통신 로그 뷰어</Description>
    <Copyright>Copyright © FACTOVA 2025</Copyright>
    
    <!-- 빌드 설정 (Publish 시 적용) -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    
    <!-- 아이콘 (있으면 설정) -->
    <!-- <ApplicationIcon>Icons\app.ico</ApplicationIcon> -->
  </PropertyGroup>

  <ItemGroup>
    <None Include=".github\workflows\release.yml" />
  </ItemGroup>

  <!-- XAML 강제 재컴파일 -->
  <ItemGroup>
    <Page Update="TabSettingsWindow.xaml">
      <Generator>MSBuild:Compile</Generator>
      <XamlRuntime>Wpf</XamlRuntime>
    </Page>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="EPPlus" Version="7.5.2" />
  </ItemGroup>

</Project>
