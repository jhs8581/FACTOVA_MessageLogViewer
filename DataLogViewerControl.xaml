<UserControl x:Class="FACTOVA_MessageLogViewer.DataLogViewerControl"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         Background="#F5F5F5"
         Loaded="UserControl_Loaded">

<UserControl.Resources>
    <Style TargetType="DataGrid">
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Item"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
    </Style>
    
    <!-- 하위 탭 스타일 (부드러운 디자인) -->
    <Style x:Key="SubTabStyle" TargetType="TabItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Border" 
                            Background="#F5F5F5" 
                            BorderThickness="1,1,1,0"
                            BorderBrush="#DDDDDD"
                            CornerRadius="4,4,0,0"
                            Margin="1,0,0,0"
                            Padding="15,8">
                        <ContentPresenter x:Name="ContentSite"
                                          ContentSource="Header"
                                          HorizontalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="White"/>
                            <Setter TargetName="Border" Property="BorderBrush" Value="#FF6B00"/>
                            <Setter TargetName="Border" Property="BorderThickness" Value="1,2,1,0"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="#EEEEEE"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Foreground" Value="#444444"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Normal"/>
    </Style>
</UserControl.Resources>

<Grid>
    <Grid.RowDefinitions>
        <RowDefinition Height="50"/>
        <RowDefinition Height="40"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="35"/>
    </Grid.RowDefinitions>

    <!-- 헤더 -->
    <Border Grid.Row="0" Background="#FF6B00">
        <Grid>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                <TextBlock Text="📊 DATA 로그" Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock x:Name="txtLogFolder" Foreground="#FFE0C0" FontSize="12" VerticalAlignment="Center" Margin="15,0,0,0"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="15,0">
                <TextBlock Text="Font:" Foreground="White" VerticalAlignment="Center" Margin="0,0,5,0" FontSize="11"/>
                <TextBox x:Name="txtFontSize" Width="32" Height="24" Text="11" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="11"/>
                <Button Content="-" Width="22" Height="24" Margin="3,0,0,0" Click="BtnFontMinus_Click" FontWeight="Bold"/>
                <Button Content="+" Width="22" Height="24" Margin="3,0,8,0" Click="BtnFontPlus_Click" FontWeight="Bold"/>
                    
                <Button Content="📐 Fit" Width="50" Height="24" Margin="0,0,15,0" Click="BtnAutoFit_Click" Background="#40FFFFFF" Foreground="White" BorderBrush="White" BorderThickness="1" FontSize="10" Cursor="Hand"/>
                <Border Width="1" Background="#FFB380" Margin="0,5,15,5"/>
                    
                <Button x:Name="btnPause" Content="⏸ 일시정지" Width="90" Height="28" Margin="0,0,8,0" Click="BtnPause_Click" Background="#40FFFFFF" Foreground="White" BorderBrush="White" BorderThickness="1" FontSize="12" Cursor="Hand"/>
                <Button Content="Clear" Width="60" Height="28" Margin="0,0,8,0" Click="BtnClear_Click" Background="#40FFFFFF" Foreground="White" BorderBrush="White" BorderThickness="1" FontSize="12" Cursor="Hand"/>
                <Button x:Name="btnAutoScroll" Content="⬇ 자동스크롤" Width="100" Height="28" Margin="0,0,8,0" Click="BtnAutoScroll_Click" Background="#4CAF50" Foreground="White" BorderBrush="White" BorderThickness="1" FontSize="11" Cursor="Hand"/>
                <Button Content="📊 Excel" Width="70" Height="28" Click="BtnExportExcel_Click" Background="#4CAF50" Foreground="White" BorderBrush="White" BorderThickness="1" FontSize="12" Cursor="Hand"/>
            </StackPanel>
        </Grid>
    </Border>

    <!-- 필터 영역 -->
    <Border Grid.Row="1" Background="#FFF3E0" BorderBrush="#FFCC80" BorderThickness="0,1">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
            <!-- 검색 -->
            <TextBlock Text="🔍 검색:" 
                       Foreground="#E65100" 
                       VerticalAlignment="Center" 
                       Margin="0,0,8,0"
                       FontSize="13"
                       FontWeight="SemiBold"/>

            <Grid Width="350" Height="28">
                <TextBox x:Name="txtSearch" 
                         Height="28"
                         VerticalAlignment="Center"
                         VerticalContentAlignment="Center"
                         Padding="8,0,30,0"
                         FontSize="12"
                         TextChanged="TxtSearch_TextChanged"
                         KeyDown="TxtSearch_KeyDown">
                    <TextBox.ToolTip>
                        <ToolTip MaxWidth="450">
                            <StackPanel>
                                <TextBlock Text="🔍 복합 검색" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>

                                <Border Background="#F0F0F0" Padding="8" CornerRadius="3" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock FontWeight="Bold" Margin="0,0,0,3">
                                            <Run Text="구분자:"/>
                                        </TextBlock>
                                        <TextBlock Margin="5,0,0,2">
                                            <Run Text="쉼표(,)" FontFamily="Consolas" FontWeight="Bold"/>
                                            <Run Text=" → OR 검색 (또는)"/>
                                        </TextBlock>
                                        <TextBlock Margin="5,0,0,0">
                                            <Run Text="플러스(+)" FontFamily="Consolas" FontWeight="Bold"/>
                                            <Run Text=" → AND 검색 (그리고)"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="📝 예시:" FontWeight="Bold" Margin="0,0,0,5"/>

                                <TextBlock Margin="5,0,0,3">
                                    <Run Text="GetData+1234" FontFamily="Consolas" FontWeight="Bold" Foreground="#E65100"/>
                                    <Run Text=" → GetData 그리고 1234 포함" Foreground="#666" FontSize="11"/>
                                </TextBlock>

                                <TextBlock Margin="5,0,0,3">
                                    <Run Text="Insert,Update" FontFamily="Consolas" FontWeight="Bold" Foreground="#E65100"/>
                                    <Run Text=" → Insert 또는 Update 포함" Foreground="#666" FontSize="11"/>
                                </TextBlock>
                            </StackPanel>
                        </ToolTip>
                    </TextBox.ToolTip>
                </TextBox>
                
                <Button x:Name="btnClearSearch" Content="✕" Width="24" Height="24" 
                        HorizontalAlignment="Right" Margin="0,0,3,0"
                        Background="Transparent" BorderThickness="0"
                        Foreground="#999" FontSize="14" Cursor="Hand"
                        Click="BtnClearSearch_Click"
                        Visibility="Collapsed"
                        ToolTip="검색어 지우기"/>
            </Grid>

            <Button Content="🔍" 
                    Width="32" Height="28"
                    Margin="5,0,0,0"
                    Click="BtnSearch_Click"
                    Background="#FF6B00"
                    Foreground="White"
                    FontSize="14"
                    Cursor="Hand"
                    ToolTip="검색 (Enter)"/>

            <TextBlock Text="ⓘ" 
                       Foreground="#E65100" 
                       VerticalAlignment="Center" 
                       Margin="5,0,20,0"
                       FontSize="14"
                       FontWeight="Bold"
                       Cursor="Help"
                       ToolTip="쉼표(,)=OR, 플러스(+)=AND&#x0a;예: GetData+1234,Insert"/>
            
            <!-- 구분선 -->
            <Border Width="1" Background="#FFCC80" Margin="0,8,20,8"/>
            
            <!-- 비즈 필터 (멀티선택) -->
            <Border Background="White" CornerRadius="4" Padding="10,4" BorderBrush="#FF9800" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📋 비즈:" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#E65100" FontWeight="SemiBold"/>
                    <Button Content="✓" Width="22" Height="22" Margin="0,0,3,0" 
                            Click="BtnBizSelectAll_Click" 
                            ToolTip="전체 선택" 
                            FontSize="10" FontWeight="Bold"
                            Background="#E8F5E9" Foreground="#2E7D32" BorderBrush="#A5D6A7" Cursor="Hand"/>
                    <Button Content="✗" Width="22" Height="22" Margin="0,0,5,0" 
                            Click="BtnBizDeselectAll_Click" 
                            ToolTip="전체 해제"
                            FontSize="10" FontWeight="Bold"
                            Background="#FFEBEE" Foreground="#C62828" BorderBrush="#EF9A9A" Cursor="Hand"/>
                    <ComboBox x:Name="cboBizFilter" Width="180" Height="24" FontSize="11" 
                              IsEditable="True" IsReadOnly="True" Text="전체"
                              DropDownOpened="CboBizFilter_DropDownOpened">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" 
                                          Click="BizFilterCheckBox_Click">
                                    <TextBlock Text="{Binding Name}"/>
                                </CheckBox>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </Border>
            
            <!-- 구분선 -->
            <Border Width="1" Background="#FFCC80" Margin="20,8,20,8"/>
            
            <!-- 느린 쿼리 필터 -->
            <Border Background="White" CornerRadius="4" Padding="10,4" BorderBrush="#F44336" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <CheckBox x:Name="chkSlowQuery" Content="🐢" VerticalAlignment="Center" Margin="0,0,5,0"
                              Checked="ChkSlowQuery_Changed" Unchecked="ChkSlowQuery_Changed"
                              ToolTip="느린 쿼리만 표시"/>
                    <TextBox x:Name="txtSlowThreshold" Width="45" Height="22" FontSize="11" Text="200"
                             VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                             KeyDown="TxtSlowThreshold_KeyDown"
                             ToolTip="ms 단위 임계값 (Enter로 적용)"/>
                    <TextBlock Text="ms+" VerticalAlignment="Center" Margin="3,0,0,0" FontSize="10" Foreground="#666"
                               Cursor="Hand" MouseLeftButtonDown="TxtSlowThresholdApply_Click"
                               ToolTip="클릭하여 필터 적용"/>
                </StackPanel>
            </Border>
            
            <!-- 구분선 -->
            <Border Width="1" Background="#FFCC80" Margin="20,8,20,8"/>
            
            <!-- 시간 이동 -->
            <Border Background="White" CornerRadius="4" Padding="10,4" BorderBrush="#FF9800" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⏰ 이동:" 
                               Foreground="#E65100" 
                               VerticalAlignment="Center" 
                               Margin="0,0,8,0"
                               FontSize="12"
                               FontWeight="SemiBold"/>
                    <TextBox x:Name="txtJumpTime" 
                             Width="55" Height="24"
                             VerticalContentAlignment="Center"
                             HorizontalContentAlignment="Center"
                             FontSize="11"
                             FontFamily="Consolas"
                             Text=""
                             ToolTip="시간 입력 후 Enter (예: 09:30, 14:00)"
                             KeyDown="TxtJumpTime_KeyDown"/>
                    <Button Content="▶" 
                            Width="28" Height="24" 
                            Margin="5,0,0,0"
                            Click="BtnJumpToTime_Click"
                            Background="#FF9800"
                            Foreground="White"
                            BorderThickness="0"
                            FontSize="10"
                            FontWeight="Bold"
                            Cursor="Hand"
                            ToolTip="해당 시간으로 이동"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

    <!-- 탭 및 데이터 그리드 -->
    <TabControl x:Name="tabControl" Grid.Row="2" Margin="10" 
                Background="White"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                ItemContainerStyle="{StaticResource SubTabStyle}"
                SelectionChanged="TabControl_SelectionChanged">
        
        <!-- 탭들은 코드에서 동적으로 생성됨 -->
        
    </TabControl>

    <!-- 상태 표시줄 -->
    <Border Grid.Row="3" Background="#EEEEEE" BorderBrush="#CCCCCC" BorderThickness="0,1,0,0" Padding="15,0">
        <Grid>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="txtStatus" Text="준비" Foreground="#333" FontSize="12"/>
                <TextBlock x:Name="txtCount" Text=" | 전체: 0건" Foreground="#E65100" FontSize="12" Margin="10,0,0,0"/>
                <TextBlock x:Name="txtTabCount" Text=" | 현재 탭: 0건" Foreground="#666" FontSize="12" Margin="5,0,0,0"/>
                <TextBlock x:Name="txtPausedCount" Text="" Foreground="#FFC107" FontSize="11" Margin="10,0,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock x:Name="txtFile" Foreground="#666" FontSize="11" FontFamily="Consolas"/>
                <TextBlock x:Name="txtMode" Text="" Foreground="#999" FontSize="11" Margin="15,0,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Grid>
</UserControl>
