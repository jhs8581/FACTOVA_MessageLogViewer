<Window x:Class="FACTOVA_MessageLogViewer.Popup.PatternAnalysisPreviewPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🔍 패턴 자동 분석 결과"
        Height="650" Width="750"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5">
    
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="🔍 태그 패턴 자동 분석 결과" FontSize="18" FontWeight="Bold" Foreground="#4CAF50"/>
            <TextBlock x:Name="txtSummary" Text="분석 결과를 확인해주세요." 
                       Foreground="#666" FontSize="12" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Toolbar -->
        <Border Grid.Row="1" Background="#E8F5E9" BorderBrush="#A5D6A7" BorderThickness="1" 
                CornerRadius="5" Padding="10" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="선택:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
                <Button Content="✅ 전체 선택" Width="90" Height="26" Click="BtnSelectAll_Click"
                        Background="#4CAF50" Foreground="White" FontSize="11" Margin="0,0,5,0"/>
                <Button Content="❌ 전체 해제" Width="90" Height="26" Click="BtnDeselectAll_Click"
                        Background="#FF5722" Foreground="White" FontSize="11" Margin="0,0,15,0"/>
                <Border Width="1" Background="#A5D6A7" Margin="0,2"/>
                <TextBlock Text="그룹:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="15,0,10,0"/>
                <Button Content="그룹만 선택" Width="80" Height="26" Click="BtnSelectGroupsOnly_Click"
                        FontSize="11" Margin="0,0,5,0" ToolTip="그룹은 유지하고 태그만 선택 해제"/>
                <Border Width="1" Background="#A5D6A7" Margin="10,2"/>
                <TextBlock x:Name="txtSelectionInfo" Text="선택: 0개 탭, 0개 그룹, 0개 태그" 
                           VerticalAlignment="Center" Foreground="#388E3C" FontSize="11" Margin="10,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Content: TreeView with Checkboxes -->
        <Border Grid.Row="2" Background="White" BorderBrush="#DDD" BorderThickness="1" CornerRadius="5">
            <TreeView x:Name="treeResult" BorderThickness="0" Padding="10"/>
        </Border>

        <!-- Footer -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <TextBlock Text="⚠️ 체크된 항목만 적용됩니다" Foreground="#F57C00" VerticalAlignment="Center" Margin="0,0,20,0"/>
            <Button Content="✅ 적용" Width="100" Height="35" Click="BtnApply_Click"
                    Background="#4CAF50" Foreground="White" FontWeight="Bold" FontSize="13"/>
            <Button Content="취소" Width="80" Height="35" Margin="10,0,0,0" Click="BtnCancel_Click"
                    FontSize="13"/>
        </StackPanel>
    </Grid>
</Window>
