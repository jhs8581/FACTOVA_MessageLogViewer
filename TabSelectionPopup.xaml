<Window x:Class="FACTOVA_MessageLogViewer.TabSelectionPopup"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
Title="탭 선택" 
Height="450" Width="450"
MinHeight="300" MinWidth="350"
WindowStartupLocation="CenterOwner"
Background="#F5F5F5"
ResizeMode="CanResizeWithGrip">
    
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 헤더 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="이 컬럼을 표시할 탭 선택" FontSize="16" FontWeight="Bold"/>
            <TextBlock Text="선택하지 않으면 모든 탭에 표시됩니다." 
                       Foreground="#666" FontSize="12" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- 탭 체크박스 리스트 -->
        <Border Grid.Row="1" 
                Background="White" 
                BorderBrush="#CCC" 
                BorderThickness="1"
                CornerRadius="5"
                Padding="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="icTabs">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding TabName}" 
                                      IsChecked="{Binding IsSelected}"
                                      Margin="5"
                                      FontSize="13"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- 버튼 -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right" 
                    Margin="0,15,0,0">
            <Button Content="전체 선택" 
                    Width="80" Height="30" 
                    Margin="0,0,5,0"
                    Click="BtnSelectAll_Click"/>
            <Button Content="전체 해제" 
                    Width="80" Height="30" 
                    Margin="0,0,15,0"
                    Click="BtnDeselectAll_Click"/>
            <Button Content="확인" 
                    Width="70" Height="30" 
                    IsDefault="True"
                    Click="BtnOk_Click"
                    Background="#2196F3"
                    Foreground="White"
                    FontWeight="Bold"/>
            <Button Content="취소" 
                    Width="70" Height="30" 
                    Margin="10,0,0,0"
                    IsCancel="True"
                    Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
