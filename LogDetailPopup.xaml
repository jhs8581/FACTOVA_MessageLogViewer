<Window x:Class="FACTOVA_MessageLogViewer.LogDetailPopup"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
Title="로그 상세 보기" 
Height="900" Width="1200"
MinHeight="600" MinWidth="800"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5"
        Icon="pack://application:,,,/Icons/free-icon-search-10725247.ico"
        ResizeMode="CanResizeWithGrip">
    
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 헤더 정보 -->
        <Border Grid.Row="0" Background="White" BorderBrush="#DDD" BorderThickness="1" CornerRadius="5" Padding="15" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="시간:" FontWeight="SemiBold" Margin="0,0,10,5"/>
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="txtTime" FontFamily="Consolas" Foreground="#1565C0"/>
                
                <TextBlock Grid.Row="0" Grid.Column="2" Text="구분:" FontWeight="SemiBold" Margin="20,0,10,5"/>
                <TextBlock Grid.Row="0" Grid.Column="3" x:Name="txtDirection" FontWeight="Bold"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="MsgId:" FontWeight="SemiBold" Margin="0,0,10,0"/>
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="txtMsgId" FontFamily="Consolas" Foreground="#1565C0"/>
                
                <TextBlock Grid.Row="1" Grid.Column="2" Text="분류:" FontWeight="SemiBold" Margin="20,0,10,0"/>
                <TextBlock Grid.Row="1" Grid.Column="3" x:Name="txtMatchedTab" Foreground="#666"/>
            </Grid>
        </Border>

        <!-- 필드 목록 -->
        <Border Grid.Row="1" Background="White" BorderBrush="#DDD" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
            <Expander Header="📋 필드 목록" IsExpanded="True">
                <DataGrid x:Name="dgFields" 
                          AutoGenerateColumns="False" 
                          IsReadOnly="True"
                          MaxHeight="250"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          Background="White"
                          Margin="0,10,0,0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="필드명" Binding="{Binding Key}" Width="150">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Margin" Value="5,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="값" Binding="{Binding Value}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Margin" Value="5,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Expander>
        </Border>

        <!-- Raw Data -->
        <Border Grid.Row="2" Background="White" BorderBrush="#DDD" BorderThickness="1" CornerRadius="5" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Raw Data" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                    <Button Content="복사" Width="60" Height="24" Margin="15,0,0,0" Click="BtnCopyRawData_Click"
                            Background="#2196F3" Foreground="White" FontWeight="Bold"/>
                </StackPanel>
                
                <TextBox Grid.Row="1" 
                         x:Name="txtRawData"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas"
                         FontSize="12"
                         Background="#1E1E1E"
                         Foreground="#D4D4D4"
                         Padding="15"/>
            </Grid>
        </Border>

        <!-- 닫기 버튼 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="닫기" Width="80" Height="32" IsCancel="True" Click="BtnClose_Click" FontSize="12"/>
        </StackPanel>
    </Grid>
</Window>
