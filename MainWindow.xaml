<Window x:Class="FACTOVA_MessageLogViewer.MainWindow"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
Title="FACTOVA 통신 로그 뷰어 - 설정" 
Height="650" Width="550"
WindowStartupLocation="CenterScreen"
SizeToContent="Height"
ResizeMode="NoResize"
Background="#F5F5F5">

    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 타이틀 -->
        <Border Grid.Row="0" Background="#2196F3" Padding="15" Margin="-20,-20,-20,20" CornerRadius="0">
            <StackPanel>
                <TextBlock Text="📡 FACTOVA 통신 로그 뷰어" 
                           FontSize="22" 
                           FontWeight="Bold" 
                           Foreground="White"/>
                <TextBlock Text="실시간 MES/PLC 통신 모니터링" 
                           FontSize="12" 
                           Foreground="#E3F2FD" 
                           Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- 로그 폴더 선택 -->
        <GroupBox Grid.Row="1" Header="📁 로그 폴더" FontSize="13">
            <StackPanel>
                <TextBox x:Name="txtLogFolder" 
                         Height="32"
                         IsReadOnly="True" 
                         VerticalContentAlignment="Center"
                         Padding="8"
                         FontSize="12"
                         FontFamily="Consolas"
                         Background="#FAFAFA"/>
                <TextBlock Text="기본폴더: 년/월 구조 자동 검색 | 사용자폴더: 해당 폴더 내 로그 검색"
                           Foreground="#666"
                           FontSize="11"
                           Margin="0,5,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0" HorizontalAlignment="Right">
                    <Button Content="기본폴더 설정" 
                            Width="120" 
                            Height="35"
                            FontSize="12"
                            Margin="0,0,10,0"
                            Click="BtnSetDefaultFolder_Click"/>
                    <Button Content="폴더 선택..." 
                            Width="100" 
                            Height="35"
                            FontSize="12"
                            Click="BtnBrowse_Click"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- 날짜 선택 -->
        <GroupBox Grid.Row="2" Header="📅 로그 날짜 선택" FontSize="13">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="날짜:" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="13"/>
                    <ComboBox x:Name="cboAvailableDates" 
                              Width="200"
                              Height="30"
                              FontSize="13"
                              DisplayMemberPath="DisplayText"
                              SelectedValuePath="Date"/>
                    <Button Content="새로고침" 
                            Width="80" 
                            Height="35"
                            Margin="10,0,0,0"
                            Click="BtnRefreshDates_Click"
                            FontSize="12"/>
                    <Button Content="컬럼설정" 
                            Width="90" 
                            Height="35"
                            Margin="10,0,0,0"
                            Click="BtnColumnSettings_Click"
                            FontSize="12"
                            ToolTip="표시할 컬럼과 필드를 설정합니다"/>
                </StackPanel>
                <TextBlock x:Name="txtDateInfo"
                           Text="폴더에서 로그 파일을 검색합니다."
                           Foreground="#666"
                           FontSize="11"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </GroupBox>

        <!-- 로그 표시 옵션 -->
        <GroupBox Grid.Row="3" Header="⚙ 로그 표시 옵션" FontSize="13">
            <StackPanel>
                <RadioButton x:Name="rbNewOnly" 
                             Content="📍 실행 시점 이후 로그만 표시 (추천 - 빠른 시작)"
                             IsChecked="True"
                             Margin="0,5"
                             FontSize="13"
                             FontWeight="Bold"/>
                <TextBlock Text="   → 기존 로그는 무시하고 프로그램 실행 후 발생하는 로그만 표시합니다."
                           Foreground="#666"
                           FontSize="12"
                           Margin="0,0,0,10"
                           TextWrapping="Wrap"/>

                <RadioButton x:Name="rbLoadRecent" 
                             Content="📚 최근 로그 로드"
                             FontSize="13"
                             Margin="0,5"/>
                <StackPanel Orientation="Horizontal" Margin="20,5,0,10">
                    <TextBlock Text="개수:" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="13"/>
                    <TextBox x:Name="txtRecentCount" 
                             Width="100" 
                             Height="28"
                             FontSize="13"
                             Text="1000" 
                             VerticalContentAlignment="Center"
                             IsEnabled="{Binding IsChecked, ElementName=rbLoadRecent}"/>
                    <TextBlock Text="개 (기본: 1000개)" 
                               VerticalAlignment="Center" 
                               FontSize="12"
                               Margin="10,0,0,0"
                               Foreground="#666"/>
                </StackPanel>

                <RadioButton x:Name="rbLoadAll" 
                             Content="📖 전체 로그 로드 (많을 경우 시간이 걸릴 수 있음)"
                             Margin="0,5"
                             Visibility="Collapsed"/>
                
                <Separator Margin="0,10"/>
                
                <CheckBox x:Name="chkAutoStart"
                          Content="🚀 프로그램 시작 시 자동으로 로그 뷰어 열기"
                          FontSize="13"
                          Margin="0,5"
                          Checked="ChkAutoStart_Changed"
                          Unchecked="ChkAutoStart_Changed"/>
            </StackPanel>
        </GroupBox>

        <!-- 하단 버튼 -->
        <StackPanel Grid.Row="5" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center"
                    Margin="0,20,0,0">
            <Button Content="시작" 
                    Width="150" 
                    Height="40"
                    FontSize="16"
                    FontWeight="Bold"
                    Background="#4CAF50"
                    Foreground="White"
                    BorderThickness="0"
                    Click="BtnStart_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="5"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" 
                                                         VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#45A049"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Button Content="종료" 
                    Width="100" 
                    Height="40"
                    Margin="10,0,0,0"
                    Click="BtnExit_Click"/>
        </StackPanel>
    </Grid>
</Window>