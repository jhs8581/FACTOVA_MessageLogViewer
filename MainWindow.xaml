<Window x:Class="FACTOVA_MessageLogViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FACTOVA_MessageLogViewer"
        xmlns:controls="clr-namespace:FACTOVA_MessageLogViewer.Controls"
        Title="FACTOVA 로그 뷰어" 
        Height="850" 
        Width="1650"
        WindowStartupLocation="CenterScreen"
        Background="#F0F0F0"
        Icon="pack://application:,,,/Icons/free-icon-search-10725247.ico"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- 공통 설정 영역 -->
        <controls:LogSettingsControl x:Name="logSettings" 
                                      Grid.Row="0"
                                      StartViewerRequested="LogSettings_StartViewerRequested"
                                      FolderChanged="LogSettings_FolderChanged"
                                      PresetSettingsRequested="LogSettings_PresetSettingsRequested"/>
        
        <!-- 로그 타입 탭 -->
        <TabControl x:Name="mainTabControl" 
                    Grid.Row="1"
                    Background="#F5F5F5"
                    BorderThickness="0"
                    Padding="0"
                    SelectionChanged="MainTabControl_SelectionChanged">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="Border" 
                                        Background="#E8E8E8" 
                                        BorderThickness="1,1,1,0"
                                        BorderBrush="#CCCCCC"
                                        CornerRadius="6,6,0,0"
                                        Margin="2,0,0,0"
                                        Padding="20,10">
                                    <ContentPresenter x:Name="ContentSite"
                                                      ContentSource="Header"
                                                      HorizontalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="White"/>
                                        <Setter TargetName="Border" Property="BorderBrush" Value="#1976D2"/>
                                        <Setter TargetName="Border" Property="BorderThickness" Value="1,3,1,0"/>
                                        <Setter Property="Foreground" Value="#1976D2"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="#F0F0F0"/>
                                    </Trigger>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="IsSelected" Value="True"/>
                                            <Condition Property="IsMouseOver" Value="True"/>
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="Border" Property="Background" Value="#FAFAFA"/>
                                    </MultiTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Foreground" Value="#555555"/>
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="FontWeight" Value="Medium"/>
                </Style>
            </TabControl.Resources>
            
            <!-- EVENT 로그 탭 -->
            <TabItem Header="📡 EVENT 로그">
                <local:EventLogViewerControl x:Name="eventLogViewer"/>
            </TabItem>
            
            <!-- DATA 로그 탭 -->
            <TabItem Header="📊 DATA 로그">
                <local:DataLogViewerControl x:Name="dataLogViewer"/>
            </TabItem>
            
            <!-- EXCEPTION 로그 탭 -->
            <TabItem Header="⚠️ EXCEPTION 로그">
                <local:ExceptionLogViewerControl x:Name="exceptionLogViewer"/>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
