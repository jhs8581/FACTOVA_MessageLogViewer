
    <UserControl x:Class="FACTOVA_MessageLogViewer.Views.ExceptionLogViewerControl"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         Background="#F5F5F5"
         Loaded="UserControl_Loaded">

<UserControl.Resources>
    <Style TargetType="DataGrid">
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Item"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
    </Style>
</UserControl.Resources>

<Grid>
    <Grid.RowDefinitions>
        <RowDefinition Height="50"/>
        <RowDefinition Height="40"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="35"/>
    </Grid.RowDefinitions>

    <!-- 헤더 -->
    <Border Grid.Row="0" Background="#D32F2F">
        <Grid>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                <TextBlock Text="⚠️ EXCEPTION 로그" Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock x:Name="txtLogFolder" Foreground="#FFCDD2" FontSize="12" VerticalAlignment="Center" Margin="15,0,0,0"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="15,0">
                <TextBlock Text="Font:" Foreground="White" VerticalAlignment="Center" Margin="0,0,5,0" FontSize="11"/>
                <TextBox x:Name="txtFontSize" Width="32" Height="24" Text="11" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="11"/>
                <Button Content="-" Width="22" Height="24" Margin="3,0,0,0" Click="BtnFontMinus_Click" FontWeight="Bold"/>
                <Button Content="+" Width="22" Height="24" Margin="3,0,8,0" Click="BtnFontPlus_Click" FontWeight="Bold"/>
                    
                <Button Content="📐 Fit" Width="50" Height="24" Margin="0,0,15,0" Click="BtnAutoFit_Click" Background="#40FFFFFF" Foreground="White" BorderBrush="White" BorderThickness="1" FontSize="10" Cursor="Hand"/>
                <Border Width="1" Background="#EF9A9A" Margin="0,5,15,5"/>
                    
                <Button x:Name="btnPause" Content="⏸ 일시정지" Width="90" Height="28" Margin="0,0,8,0" Click="BtnPause_Click" Background="#40FFFFFF" Foreground="White" BorderBrush="White" BorderThickness="1" FontSize="12" Cursor="Hand"/>
                <Button Content="Clear" Width="60" Height="28" Margin="0,0,8,0" Click="BtnClear_Click" Background="#40FFFFFF" Foreground="White" BorderBrush="White" BorderThickness="1" FontSize="12" Cursor="Hand"/>
                <Button x:Name="btnAutoScroll" Content="⬇ 자동스크롤" Width="100" Height="28" Margin="0,0,8,0" Click="BtnAutoScroll_Click" Background="#4CAF50" Foreground="White" BorderBrush="White" BorderThickness="1" FontSize="11" Cursor="Hand"/>
                <Button Content="📊 Excel" Width="70" Height="28" Click="BtnExportExcel_Click" Background="#4CAF50" Foreground="White" BorderBrush="White" BorderThickness="1" FontSize="12" Cursor="Hand"/>
            </StackPanel>
        </Grid>
    </Border>

    <!-- 필터 영역 -->
    <Border Grid.Row="1" Background="#FFEBEE" BorderBrush="#EF9A9A" BorderThickness="0,1">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
            <!-- 검색 -->
            <TextBlock Text="🔍 검색:" 
                       Foreground="#C62828" 
                       VerticalAlignment="Center" 
                       Margin="0,0,8,0"
                       FontSize="13"
                       FontWeight="SemiBold"/>

            <Grid Width="350" Height="28">
                <TextBox x:Name="txtSearch" 
                         Height="28"
                         VerticalAlignment="Center"
                         VerticalContentAlignment="Center"
                         Padding="8,0,30,0"
                         FontSize="12"
                         TextChanged="TxtSearch_TextChanged"
                         KeyDown="TxtSearch_KeyDown">
                    <TextBox.ToolTip>
                        <ToolTip>
                            <TextBlock Text="쉼표(,)=OR, 플러스(+)=AND"/>
                        </ToolTip>
                    </TextBox.ToolTip>
                </TextBox>
                
                <Button x:Name="btnClearSearch" Content="✕" Width="24" Height="24" 
                        HorizontalAlignment="Right" Margin="0,0,3,0"
                        Background="Transparent" BorderThickness="0"
                        Foreground="#999" FontSize="14" Cursor="Hand"
                        Click="BtnClearSearch_Click"
                        Visibility="Collapsed"
                        ToolTip="검색어 지우기"/>
            </Grid>

            <Button Content="🔍" 
                    Width="32" Height="28"
                    Margin="5,0,0,0"
                    Click="BtnSearch_Click"
                    Background="#D32F2F"
                    Foreground="White"
                    FontSize="14"
                    Cursor="Hand"
                    ToolTip="검색 (Enter)"/>

            <TextBlock Text="ⓘ" 
                       Foreground="#C62828" 
                       VerticalAlignment="Center" 
                       Margin="5,0,20,0"
                       FontSize="14"
                       FontWeight="Bold"
                       Cursor="Help"
                       ToolTip="쉼표(,)=OR, 플러스(+)=AND"/>
            
            <!-- 구분선 -->
            <Border Width="1" Background="#EF9A9A" Margin="0,8,20,8"/>
            
            <!-- 시간 이동 -->
            <Border Background="White" CornerRadius="4" Padding="10,4" BorderBrush="#D32F2F" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⏰ 이동:" 
                               Foreground="#C62828" 
                               VerticalAlignment="Center" 
                               Margin="0,0,8,0"
                               FontSize="12"
                               FontWeight="SemiBold"/>
                    <TextBox x:Name="txtJumpTime" 
                             Width="55" Height="24"
                             VerticalContentAlignment="Center"
                             HorizontalContentAlignment="Center"
                             FontSize="11"
                             FontFamily="Consolas"
                             Text=""
                             ToolTip="시간 입력 후 Enter (예: 09:30, 14:00)"
                             KeyDown="TxtJumpTime_KeyDown"/>
                    <Button Content="▶" 
                            Width="28" Height="24" 
                            Margin="5,0,0,0"
                            Click="BtnJumpToTime_Click"
                            Background="#D32F2F"
                            Foreground="White"
                            BorderThickness="0"
                            FontSize="10"
                            FontWeight="Bold"
                            Cursor="Hand"
                            ToolTip="해당 시간으로 이동"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

    <!-- 데이터 그리드 -->
    <DataGrid x:Name="dataGrid" 
              Grid.Row="2" 
              Margin="10"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              CanUserAddRows="False"
              CanUserDeleteRows="False"
              CanUserReorderColumns="False"
              CanUserResizeRows="False"
              CanUserSortColumns="True"
              SelectionMode="Extended"
              SelectionUnit="FullRow"
              ClipboardCopyMode="ExcludeHeader"
              GridLinesVisibility="All"
              HeadersVisibility="Column"
              RowHeaderWidth="0"
              FontSize="11"
              FontFamily="Consolas"
              EnableRowVirtualization="True"
              EnableColumnVirtualization="True"
              MouseDoubleClick="DataGrid_MouseDoubleClick"
              PreviewKeyDown="DataGrid_PreviewKeyDown">
        <DataGrid.Resources>
            <Style TargetType="DataGridColumnHeader">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Background" Value="#F0F0F0"/>
                <Setter Property="Foreground" Value="#3C3C3C"/>
                <Setter Property="Padding" Value="8"/>
                <Setter Property="BorderBrush" Value="#DCDCDC"/>
                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
            </Style>
            <Style TargetType="DataGridRow">
                <Setter Property="MinHeight" Value="28"/>
            </Style>
            <Style TargetType="DataGridCell">
                <Setter Property="Padding" Value="10,4"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
        </DataGrid.Resources>
        <DataGrid.HorizontalGridLinesBrush>
            <SolidColorBrush Color="#E6E6E6"/>
        </DataGrid.HorizontalGridLinesBrush>
        <DataGrid.VerticalGridLinesBrush>
            <SolidColorBrush Color="#E6E6E6"/>
        </DataGrid.VerticalGridLinesBrush>
        <DataGrid.Columns>
            <DataGridTextColumn Header="No" Binding="{Binding RowNumber}" Width="50"/>
            <DataGridTextColumn Header="시간" Binding="{Binding TimeString}" Width="90"/>
            <DataGridTextColumn Header="예외 타입" Binding="{Binding ExceptionType}" Width="200"/>
            <DataGridTextColumn Header="메시지" Binding="{Binding Message}" Width="400"/>
            <DataGridTextColumn Header="소스" Binding="{Binding Source}" Width="150"/>
            <DataGridTextColumn Header="상세" Binding="{Binding Summary}" Width="*"/>
        </DataGrid.Columns>
    </DataGrid>

    <!-- 상태 표시줄 -->
    <Border Grid.Row="3" Background="#EEEEEE" BorderBrush="#CCCCCC" BorderThickness="0,1,0,0" Padding="15,0">
        <Grid>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="txtStatus" Text="준비" Foreground="#333" FontSize="12"/>
                <TextBlock x:Name="txtCount" Text=" | 전체: 0건" Foreground="#C62828" FontSize="12" Margin="10,0,0,0"/>
                <TextBlock x:Name="txtPausedCount" Text="" Foreground="#FFC107" FontSize="11" Margin="10,0,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock x:Name="txtFile" Foreground="#666" FontSize="11" FontFamily="Consolas"/>
                <TextBlock x:Name="txtMode" Text="" Foreground="#999" FontSize="11" Margin="15,0,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Grid>
</UserControl>
