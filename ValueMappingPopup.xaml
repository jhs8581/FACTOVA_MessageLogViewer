<Window x:Class="FACTOVA_MessageLogViewer.ValueMappingPopup"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
Title="값 매핑 설정" 
Height="450" Width="500"
MinHeight="350" MinWidth="400"
WindowStartupLocation="CenterOwner"
Background="#F5F5F5"
Icon="pack://application:,,,/Icons/free-icon-search-10725247.ico"
ResizeMode="CanResizeWithGrip">
    
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 헤더 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="값 매핑 설정" FontSize="16" FontWeight="Bold"/>
            <TextBlock Text="원본 값을 표시할 이름으로 매핑합니다." 
                       Foreground="#666" FontSize="12" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- 매핑 그리드 -->
        <Border Grid.Row="1" 
                Background="White" 
                BorderBrush="#CCC" 
                BorderThickness="1"
                CornerRadius="5">
            <DataGrid x:Name="dgMappings"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            CanUserDeleteRows="True"
            GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      RowHeight="30"
                      FontSize="12"
                      Margin="5">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="원본 값" 
                                        Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}" 
                                        Width="150">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="5,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                        <DataGridTextColumn.EditingElementStyle>
                            <Style TargetType="TextBox">
                                <Setter Property="Padding" Value="5,0"/>
                            </Style>
                        </DataGridTextColumn.EditingElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="표시 이름" 
                                        Binding="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" 
                                        Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="5,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                        <DataGridTextColumn.EditingElementStyle>
                            <Style TargetType="TextBox">
                                <Setter Property="Padding" Value="5,0"/>
                            </Style>
                        </DataGridTextColumn.EditingElementStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Header="" Width="40">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="✕" 
                                        Width="24" Height="24"
                                        Click="BtnDeleteRow_Click"
                                        Tag="{Binding}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Foreground="#999"
                                        FontWeight="Bold"
                                        Cursor="Hand"
                                        ToolTip="삭제"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 미리보기 -->
        <Border Grid.Row="2" 
                Background="#E8F5E9" 
                BorderBrush="#A5D6A7" 
                BorderThickness="1"
                CornerRadius="3"
                Padding="10"
                Margin="0,10,0,0">
            <StackPanel>
                <TextBlock Text="결과 미리보기:" FontWeight="SemiBold" FontSize="11" Foreground="#388E3C"/>
                <TextBlock x:Name="txtPreview" 
                           Text="" 
                           FontFamily="Consolas" 
                           FontSize="11" 
                           Foreground="#2E7D32"
                           TextWrapping="Wrap"
                           Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- 버튼 -->
        <StackPanel Grid.Row="3" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right" 
                    Margin="0,15,0,0">
            <Button Content="+ 행 추가" 
                    Width="80" Height="30" 
                    Margin="0,0,15,0"
                    Click="BtnAddRow_Click"/>
            <Button Content="확인" 
                    Width="70" Height="30" 
                    IsDefault="True"
                    Click="BtnOk_Click"
                    Background="#2196F3"
                    Foreground="White"
                    FontWeight="Bold"/>
            <Button Content="취소" 
                    Width="70" Height="30" 
                    Margin="10,0,0,0"
                    IsCancel="True"
                    Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
