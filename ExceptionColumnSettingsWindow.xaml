<Window x:Class="FACTOVA_MessageLogViewer.ExceptionColumnSettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="EXCEPTION 로그 프리셋 설정" 
    Height="650" 
    Width="950"
    WindowStartupLocation="CenterOwner"
    Background="#F5F5F5"
    Icon="pack://application:,,,/Icons/free-icon-search-10725247.ico">
    
<Grid Margin="15">
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <StackPanel Grid.Row="0" Margin="0,0,0,10">
        <TextBlock Text="⚠️ EXCEPTION 로그 프리셋 설정" FontSize="18" FontWeight="Bold" Foreground="#D32F2F"/>
        <TextBlock Text="컬럼 설정이 프리셋으로 저장됩니다."
                   Foreground="#666" FontSize="12" Margin="0,5,0,0"/>
    </StackPanel>

    <!-- Preset Management -->
    <GroupBox Grid.Row="1" Header="프리셋" Margin="0,0,0,10" Padding="10"
              Background="#FFEBEE" BorderBrush="#EF5350">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="프리셋:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
            <ComboBox x:Name="cboPresets" Width="180" Height="28" FontSize="12"
                      SelectionChanged="CboPresets_SelectionChanged"/>
            <Button Content="저장" Width="60" Height="28" Margin="15,0,0,0" Click="BtnSave_Click"
                    ToolTip="현재 프리셋에 저장"/>
            <Border Width="1" Background="#CCC" Margin="15,2"/>
            <TextBlock Text="새 이름:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <Grid Width="130" Height="28">
                <TextBox x:Name="txtPresetName" Height="28" 
                         VerticalContentAlignment="Center" FontSize="12" Padding="5,0,25,0"
                         ToolTip="새 프리셋 이름 입력"
                         TextChanged="TxtPresetName_TextChanged"/>
                <Button x:Name="btnClearPresetName" Content="✕" Width="20" Height="20" 
                        HorizontalAlignment="Right" Margin="0,0,4,0"
                        Background="Transparent" BorderThickness="0"
                        Foreground="#999" FontSize="14" Cursor="Hand"
                        Click="BtnClearPresetName_Click"
                        Visibility="Collapsed"
                        ToolTip="이름 지우기"/>
            </Grid>
            <Button Content="다른이름저장" Width="80" Height="28" Margin="10,0,0,0" Click="BtnNewPreset_Click"/>
            <Border Width="1" Background="#CCC" Margin="15,2"/>
            <Button Content="🗑 삭제" Width="60" Height="28" Click="BtnDeletePreset_Click"
                    Background="#FFCDD2" Foreground="#C62828" BorderBrush="#EF9A9A"
                    ToolTip="현재 선택된 프리셋 삭제 (Default는 삭제 불가)"/>
            <Button Content="📂 폴더" Width="60" Height="28" Margin="5,0,0,0" Click="BtnOpenPresetFolder_Click"
                    ToolTip="프리셋 저장 폴더를 파일 탐색기로 열기"/>
        </StackPanel>
    </GroupBox>
        
        
        <!-- 중앙: 컬럼 설정 -->
        <Border Grid.Row="2" Background="White" CornerRadius="5" Padding="10" BorderBrush="#DDD" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <TextBlock Grid.Row="0" Text="📋 컬럼 설정" FontSize="14" FontWeight="SemiBold" Foreground="#555" Margin="0,0,0,8"/>
                <TextBlock Grid.Row="0" Text="(표시할 컬럼과 순서를 설정합니다)" 
                           FontSize="11" Foreground="#888" VerticalAlignment="Bottom" Margin="0,0,0,8" HorizontalAlignment="Right"/>
                
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Column: 컬럼으로 표시 | Hidden: 숨김"
                               Foreground="#666" FontSize="11" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <Border Width="1" Background="#CCC" Margin="0,2"/>
                    <Button Content="▲ 위로" Width="60" Height="26" Margin="15,0,5,0" Click="BtnMoveUp_Click" FontSize="11" 
                            ToolTip="선택한 항목을 위로 이동" Background="#D32F2F" Foreground="White" FontWeight="SemiBold"/>
                    <Button Content="▼ 아래로" Width="65" Height="26" Click="BtnMoveDown_Click" FontSize="11"
                            ToolTip="선택한 항목을 아래로 이동" Background="#D32F2F" Foreground="White" FontWeight="SemiBold"/>
                </StackPanel>
                
                <DataGrid Grid.Row="2" x:Name="dgFields" 
                          AutoGenerateColumns="False" 
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Single"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          Background="White"
                          RowHeight="32"
                          FontSize="12">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="표시" Binding="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="50">
                            <DataGridCheckBoxColumn.ElementStyle>
                                <Style TargetType="CheckBox">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridCheckBoxColumn.ElementStyle>
                        </DataGridCheckBoxColumn>
                        <DataGridTextColumn Header="순서" Binding="{Binding Order, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="60">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="필드명" Binding="{Binding FieldName}" Width="180" IsReadOnly="True"/>
                        <DataGridTextColumn Header="표시 이름" Binding="{Binding DisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="150"/>
                        <DataGridTextColumn Header="너비" Binding="{Binding ColumnWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="설명" Binding="{Binding Description}" Width="*" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#666"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
        
        <!-- Bottom Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="초기화" Width="80" Height="32" Click="BtnReset_Click" FontSize="12"
                    ToolTip="기본 설정으로 되돌립니다"/>
            <Button Content="미리보기" Width="80" Height="32" Margin="10,0,0,0" Click="BtnPreview_Click" FontSize="12"/>
            <Button Content="취소" Width="80" Height="32" Margin="10,0,0,0" Click="BtnCancel_Click" FontSize="12"/>
            <Button Content="적용" Width="100" Height="32" Margin="10,0,0,0" 
                    Background="#4CAF50" Foreground="White" FontWeight="Bold"
                    Click="BtnApply_Click" FontSize="12"/>
        </StackPanel>
    </Grid>
</Window>
