<Window x:Class="FACTOVA_MessageLogViewer.DataColumnSettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="DATA 로그 프리셋 설정"
    Height="650"
    Width="950"
    WindowStartupLocation="CenterOwner"
    Background="#F5F5F5"
    Icon="pack://application:,,,/Icons/free-icon-search-10725247.ico">

<Grid Margin="15">
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <StackPanel Grid.Row="0" Margin="0,0,0,10">
        <TextBlock Text="📊 DATA 로그 프리셋 설정" FontSize="18" FontWeight="Bold" Foreground="#FF9800"/>
        <TextBlock Text="컬럼 설정이 프리셋으로 저장됩니다."
                   Foreground="#666" FontSize="12" Margin="0,5,0,0"/>
    </StackPanel>

        <!-- Preset Management -->
        <GroupBox Grid.Row="1" Header="프리셋" Margin="0,0,0,10" Padding="10"
                  Background="#FFF3E0" BorderBrush="#FFB74D">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="프리셋:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                <ComboBox x:Name="cboPresets" Width="180" Height="28" FontSize="12"
                          SelectionChanged="CboPresets_SelectionChanged"/>
                <Button Content="저장" Width="60" Height="28" Margin="15,0,0,0" Click="BtnSave_Click"
                        ToolTip="현재 프리셋에 저장"/>
                <Border Width="1" Background="#CCC" Margin="15,2"/>
                <TextBlock Text="새 이름:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Grid Width="130" Height="28">
                    <TextBox x:Name="txtPresetName" Height="28" 
                             VerticalContentAlignment="Center" FontSize="12" Padding="5,0,25,0"
                             ToolTip="새 프리셋 이름 입력"
                             TextChanged="TxtPresetName_TextChanged"/>
                    <Button x:Name="btnClearPresetName" Content="✕" Width="20" Height="20" 
                            HorizontalAlignment="Right" Margin="0,0,4,0"
                            Background="Transparent" BorderThickness="0"
                            Foreground="#999" FontSize="14" Cursor="Hand"
                            Click="BtnClearPresetName_Click"
                            Visibility="Collapsed"
                            ToolTip="이름 지우기"/>
                </Grid>
                <Button Content="다른이름저장" Width="80" Height="28" Margin="10,0,0,0" Click="BtnNewPreset_Click"/>
                <Border Width="1" Background="#CCC" Margin="15,2"/>
                <Button Content="🗑 삭제" Width="60" Height="28" Click="BtnDeletePreset_Click"
                        Background="#FFEBEE" Foreground="#C62828" BorderBrush="#EF9A9A"
                        ToolTip="현재 선택된 프리셋 삭제 (Default는 삭제 불가)"/>
                <Button Content="📂 폴더" Width="60" Height="28" Margin="5,0,0,0" Click="BtnOpenPresetFolder_Click"
                        ToolTip="프리셋 저장 폴더를 파일 탐색기로 열기"/>
            </StackPanel>
        </GroupBox>

        <!-- 중앙: 컬럼 설정 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 왼쪽: 기본 필드 -->
            <Border Grid.Column="0" Background="White" CornerRadius="5" Padding="10" BorderBrush="#DDD" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="📋 기본 필드" FontSize="14" FontWeight="SemiBold" Foreground="#555" Margin="0,0,0,10"/>

                    <DataGrid Grid.Row="1" x:Name="dgBasicFields"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              Background="White"
                              RowHeight="30"
                              FontSize="12">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="표시" Binding="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="50">
                                <DataGridCheckBoxColumn.ElementStyle>
                                    <Style TargetType="CheckBox">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridCheckBoxColumn.ElementStyle>
                            </DataGridCheckBoxColumn>
                            <DataGridTextColumn Header="필드명" Binding="{Binding FieldName}" Width="130" IsReadOnly="True"/>
                            <DataGridTextColumn Header="표시 이름" Binding="{Binding DisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- 오른쪽: 파라미터 필드 -->
            <Border Grid.Column="2" Background="White" CornerRadius="5" Padding="10" BorderBrush="#DDD" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="🔧 파라미터 컬럼" FontSize="14" FontWeight="SemiBold" Foreground="#555" VerticalAlignment="Center"/>
                        <TextBlock Text="(XML에서 추출)" FontSize="11" Foreground="#888" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        <Button Content="🔄 로그분석" Width="80" Height="26" Margin="15,0,0,0" Click="BtnAnalyzeParams_Click" 
                                Background="#FF9800" Foreground="White" FontSize="11" FontWeight="SemiBold"
                                ToolTip="로드된 로그에서 파라미터 목록을 추출합니다"/>
                    </StackPanel>

                    <!-- 파라미터 추가 -->
                    <Border Grid.Row="1" Background="#FFE0B2" BorderBrush="#FF9800" BorderThickness="1" CornerRadius="3" Padding="8" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="📋 로그에서 선택:" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                            <ComboBox Grid.Column="1" x:Name="cboAvailableParams" Height="26" FontSize="11" MinWidth="150"
                                      ToolTip="로그에서 발견된 파라미터 목록" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="2" Text="표시명:" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                            <TextBox Grid.Column="3" x:Name="txtParamDisplayFromCombo" Width="100" Height="26" FontSize="11" VerticalContentAlignment="Center"
                                     ToolTip="선택한 파라미터의 표시 이름" Margin="0,0,10,0"/>
                            <Button Grid.Column="4" Content="➕ 추가" Width="70" Height="26" Click="BtnAddParamFromCombo_Click"
                                    Background="#4CAF50" Foreground="White" FontWeight="Bold" FontSize="11"
                                    ToolTip="선택한 파라미터를 컬럼으로 추가"/>
                        </Grid>
                    </Border>

                    <DataGrid Grid.Row="2" x:Name="dgParamFields"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              Background="White"
                              RowHeight="30"
                              FontSize="12">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="표시" Binding="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="50">
                                <DataGridCheckBoxColumn.ElementStyle>
                                    <Style TargetType="CheckBox">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridCheckBoxColumn.ElementStyle>
                            </DataGridCheckBoxColumn>
                            <DataGridTextColumn Header="필드명" Binding="{Binding FieldName, Mode=TwoWay}" Width="180"/>
                            <DataGridTextColumn Header="표시 이름" Binding="{Binding DisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="130"/>
                            <DataGridTextColumn Header="값 변환" Binding="{Binding ValueMapping, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="ToolTip" Value="예: 1=ON,0=OFF,Y=사용,N=미사용"/>
                                        <Setter Property="Foreground" Value="#666"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="" Width="40">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="✕" Click="BtnRemoveParam_Click"
                                                Background="Transparent" Foreground="#C62828"
                                                BorderThickness="0" Cursor="Hand" FontWeight="Bold"
                                                ToolTip="삭제"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- Bottom Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="초기화" Width="80" Height="32" Click="BtnReset_Click" FontSize="12"
                    ToolTip="기본 설정으로 되돌립니다"/>
            <Button Content="미리보기" Width="80" Height="32" Margin="10,0,0,0" Click="BtnPreview_Click" FontSize="12"/>
            <Button Content="취소" Width="80" Height="32" Margin="10,0,0,0" Click="BtnCancel_Click" FontSize="12"/>
            <Button Content="적용" Width="100" Height="32" Margin="10,0,0,0" 
                    Background="#4CAF50" Foreground="White" FontWeight="Bold"
                    Click="BtnApply_Click" FontSize="12"/>
        </StackPanel>
    </Grid>
</Window>
