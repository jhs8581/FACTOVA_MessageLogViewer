<Window x:Class="FACTOVA_MessageLogViewer.DataColumnSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DATA 로그 프리셋 설정"
        Height="650"
        Width="900"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 상단: 프리셋 선택 -->
        <Border Grid.Row="0" Background="White" CornerRadius="5" Padding="15" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🎨 프리셋:" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox x:Name="cboPresets" Width="200" Height="28" FontSize="12" SelectionChanged="CboPresets_SelectionChanged"/>
                <Button Content="새 프리셋" Width="80" Height="28" Margin="10,0,0,0" Click="BtnNewPreset_Click"/>
                <Button Content="삭제" Width="60" Height="28" Margin="5,0,0,0" Click="BtnDeletePreset_Click"
                        Foreground="#D32F2F"/>

                <Border Width="1" Background="#DDD" Margin="20,0"/>

                <TextBlock Text="느린쿼리 임계값:" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="txtSlowThreshold" Width="60" Height="28" Text="100"
                         VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                <TextBlock Text="ms" FontSize="12" VerticalAlignment="Center" Margin="5,0,0,0" Foreground="#666"/>
            </StackPanel>
        </Border>

        <!-- 중앙: 컬럼 설정 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 왼쪽: 기본 필드 -->
            <Border Grid.Column="0" Background="White" CornerRadius="5" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="📋 기본 필드" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>

                    <DataGrid Grid.Row="1" x:Name="dgBasicFields"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              GridLinesVisibility="Horizontal"
                              RowHeight="28"
                              FontSize="11">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="표시" Binding="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="45"/>
                            <DataGridTextColumn Header="필드명" Binding="{Binding FieldName}" Width="120" IsReadOnly="True"/>
                            <DataGridTextColumn Header="표시 이름" Binding="{Binding DisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                            <DataGridTextColumn Header="너비" Binding="{Binding ColumnWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- 오른쪽: 파라미터 필드 -->
            <Border Grid.Column="2" Background="White" CornerRadius="5" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="🔧 파라미터 컬럼" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Text="(XML에서 추출)" FontSize="11" Foreground="#666" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>

                    <!-- 파라미터 추가 -->
                    <Border Grid.Row="1" Background="#F0F0F0" CornerRadius="3" Padding="8" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="필드명:" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBox x:Name="txtNewParamField" Width="120" Height="26" FontSize="11" VerticalContentAlignment="Center"/>
                            <TextBlock Text="표시명:" FontSize="11" VerticalAlignment="Center" Margin="10,0,5,0"/>
                            <TextBox x:Name="txtNewParamDisplay" Width="80" Height="26" FontSize="11" VerticalContentAlignment="Center"/>
                            <Button Content="+ 추가" Width="60" Height="26" Margin="10,0,0,0" Click="BtnAddParam_Click"
                                    Background="#4CAF50" Foreground="White" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <DataGrid Grid.Row="2" x:Name="dgParamFields"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              GridLinesVisibility="Horizontal"
                              RowHeight="28"
                              FontSize="11">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="표시" Binding="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="45"/>
                            <DataGridTextColumn Header="필드명" Binding="{Binding FieldName, Mode=TwoWay}" Width="120"/>
                            <DataGridTextColumn Header="표시 이름" Binding="{Binding DisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                            <DataGridTextColumn Header="너비" Binding="{Binding ColumnWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="50"/>
                            <DataGridTextColumn Header="값 변환" Binding="{Binding ValueMapping, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="ToolTip" Value="예: 1=ON,0=OFF,Y=사용,N=미사용"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="" Width="40">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="✕" Click="BtnRemoveParam_Click"
                                                Background="Transparent" Foreground="#D32F2F"
                                                BorderThickness="0" Cursor="Hand" FontWeight="Bold"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- 하단: 버튼 -->
        <Border Grid.Row="2" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="미리보기" Width="90" Height="32" Margin="0,0,10,0" Click="BtnPreview_Click"/>
                <Button Content="저장" Width="90" Height="32" Margin="0,0,10,0" Click="BtnSave_Click"
                        Background="#2196F3" Foreground="White" FontWeight="Bold"/>
                <Button Content="취소" Width="90" Height="32" Click="BtnCancel_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
